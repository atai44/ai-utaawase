{"poems":[{"ban":4,"ku":["短か夜の","空に残れる","有明の","月かげ淡く","風わたるなり"],"yomi":["みじかよの","そらにのこれる","ありあけの","つきかげあわく","かぜわたるなり"]},{"ban":5,"ku":["苔むせる","岩のはざまを","洩る水の","音すずしさに","手をひたしけり"],"yomi":["こけむせる","いわのはざまを","もるみずの","おとすずしさに","てをひたしけり"]},{"ban":10,"ku":["逢ふことの","夢かとまがふ","初めより","胸のさわぎは","今もしづまず"],"yomi":["あふことの","ゆめかとまがふ","はじめより","むねのさわぎは","いまもしづまず"]},{"ban":15,"ku":["千年の","風をかさねて","老松の","枝はたるれど","色はかはらず"],"yomi":["ちとせの","かぜをかさねて","おいまつの","えだはたるれど","いろはかはらず"]}]}
