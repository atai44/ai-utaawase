{"poems":[{"ban":1,"ku":["梅が香を","映すすべなき","水鏡","花の影のみ","澄みて流るる"],"yomi":["うめがかを","うつすすべなき","みづかがみ","はなのかげのみ","すみてながるる"]},{"ban":5,"ku":["掬ぶ手に","夏を忘るる","岩清水","苔の雫の","音も涼しく"],"yomi":["むすぶてに","なつをわするる","いはしみづ","こけのしづくの","おともすずしく"]},{"ban":9,"ku":["夜を寒み","床の辺近く","きりぎりす","鳴く音に我も","寝ねがてにする"],"yomi":["よをさむみ","とこのへちかく","きりぎりす","なくねにわれも","いねがてにする"]},{"ban":16,"ku":["朝霧に","刈田の庵は","隠れつつ","煙ひとすぢ","立ちのぼる見ゆ"],"yomi":["あさぎりに","かりたのいほは","かくれつつ","けぶりひとすぢ","たちのぼるみゆ"]}]}
