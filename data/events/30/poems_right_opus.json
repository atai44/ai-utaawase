{"poems":[
{"ban":4,"ku":["明けやすき","夜半の名残の","月影に","涼しさ残る","槙の板戸よ"],"yomi":["あけやすき","よはのなごりの","つきかげに","すずしさのこる","まきのいたどよ"]},
{"ban":6,"ku":["降り暮らす","雨にいくたび","色かへて","濡れてぞ深き","庭の紫陽花"],"yomi":["ふりくらす","あめにいくたび","いろかへて","ぬれてぞふかき","にはのあぢさゐ"]},
{"ban":11,"ku":["別れても","同じ光を","頼むかな","君が袖にも","宿る月影"],"yomi":["わかれても","おなじひかりを","たのむかな","きみがそでにも","やどるつきかげ"]},
{"ban":13,"ku":["這ひかかる","岩根の蔦の","紅に","色に出でじと","思ひしものを"],"yomi":["はひかかる","いはねのつたの","くれなゐに","いろにいでじと","おもひしものを"]}
]}
