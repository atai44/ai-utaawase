{"poems":[{"ban":3,"ku":["春日野の","草のみどりに","袖濡れて","遊ぶ童も","霞に消えぬ"],"yomi":["はるひのの","くさのみどりに","そでぬれて","あそぶわらべも","かすみにきえぬ"]},{"ban":8,"ku":["旅枕","月のひかりに","目をさませば","故郷とほき","虫の声かな"],"yomi":["たびまくら","つきのひかりに","めをさませば","ふるさととほき","むしのこゑかな"]},{"ban":10,"ku":["初めてし","逢ふ夜の月の","明けゆくを","惜しと思ふも","言ひ出でがたし"],"yomi":["はじめてし","あふよのつきの","あけゆくを","をしとおもふも","いひいでがたし"]},{"ban":14,"ku":["峠まで","登りつきたる","茶屋の縁","ぬるき茶をすふ","雲の行く末"],"yomi":["たふげまで","のぼりつきたる","ちゃやのえん","ぬるきちゃをすふ","くものゆくすゑ"]}]}
