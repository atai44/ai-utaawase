{"poems":[{"ban":2,"ku":["川辺にて","桃の花咲く","春の風","色移りゆく","川の水面に"],"yomi":["かわべにて","ももののはなさく","はるのかぜ","いろうつりゆく","かわのみなもに"]},{"ban":7,"ku":["松虫の","声かすかなり","軒の月","秋の夜ふかし","ひとり眺めて"],"yomi":["まつむしの","こえかすかなり","のきのつき","あきのよふかし","ひとりながめて"]},{"ban":12,"ku":["文ひとつ","封じたままの","心かな","開かぬうちに","恋はそのまま"],"yomi":["ふみひとつ","ふうじたままの","こころかな","ひらかぬうちに","こいはそのまま"]},{"ban":15,"ku":["老松の","緑は深く","雪を載せ","時を経にける","千歳の色か"],"yomi":["おいまつの","みどりはふかく","ゆきをのせ","ときをへにける","ちとせのいろか"]}]}
