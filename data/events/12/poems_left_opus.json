{"poems":[{"ban":2,"ku":["苗代の","水にうつろふ","夕月を","蛙の声ぞ","ひとり揺らせる"],"yomi":["なはしろの","みづにうつろふ","ゆふづきを","かはづのこゑぞ","ひとりゆらせる"]},{"ban":7,"ku":["招くとも","誰か来るべき","秋の野の","尾花が末に","月ぞ宿れる"],"yomi":["まねくとも","たれかくるべき","あきののの","をばながすゑに","つきぞやどれる"]},{"ban":12,"ku":["訪ひ来つと","聞くぞつらしき","我もまた","君が門にて","待ちし夕べを"],"yomi":["とひきつと","きくぞつらしき","われもまた","きみがかどにて","まちしゆふべを"]},{"ban":14,"ku":["ふる里の","軒の雫を","数へつつ","聞きし人なき","夜半の雨かな"],"yomi":["ふるさとの","のきのしづくを","かぞへつつ","ききしひとなき","よはのあめかな"]}]}
