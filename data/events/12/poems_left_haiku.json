{"poems":[{"ban":4,"ku":["沢の辺に","杜若咲く","水鏡","紫深く","夏は来にけり"],"yomi":["さわのへに","かきつばたさく","みずかがみ","むらさきふかく","なつはきにけり"]},{"ban":8,"ku":["霜白く","草木も枯れて","池の面","静かに凍る","庭の冬かな"],"yomi":["しもしろく","くさきもかれて","いけのおも","しずかにこおる","にわのふゆかな"]},{"ban":10,"ku":["黒髪を","梳けば思ひぞ","櫛の歯に","君が名ぞ立つ","恋ぞ知らるる"],"yomi":["くろかみを","すけばおもひぞ","くしのはに","きみがなぞたつ","こひぞしらるる"]},{"ban":15,"ku":["年経れば","身の衰へて","白髪に","老いの嘆きも","月ぞかなしき"],"yomi":["としふれば","みのおとろへて","しらがに","おいのなげきも","つきぞかなしき"]}]}
