{"poems":[
{"ban":3,"ku":["水鶏鳴く","葎の宿の","月暗み","戸ならぬ戸をも","叩く夜半かな"],"yomi":["くいななく","むぐらのやどの","つきくらみ","とならぬとをも","たたくよわかな"]},
{"ban":6,"ku":["刈り残す","稲葉にそそぐ","秋の雨","庵の軒の","音ぞ寂しき"],"yomi":["かりのこす","いなばにそそぐ","あきのあめ","いほのきの","おとぞさびしき"]},
{"ban":11,"ku":["来ぬ人を","待つ夜の更けて","灯の","影もかすかに","なりまさるかな"],"yomi":["こぬひとを","まつよのふけて","ともしびの","かげもかすかに","なりまさるかな"]},
{"ban":13,"ku":["忍ぶれど","色に出でにし","わが恋は","袖の涙の","つひに顕はれ"],"yomi":["しのぶれど","いろにいでにし","わがこひは","そでのなみだの","つひにあらはれ"]}
]}
