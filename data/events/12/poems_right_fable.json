{"poems":[{"ban":1,"ku":["吹くとしも","見えぬ風さへ","色に出て","岸の柳の","糸になびける"],"yomi":["ふくとしも","みえぬかぜさえ","いろにでて","きしのやなぎの","いとになびける"]},{"ban":6,"ku":["刈り残す","門田の稲葉","濡れそぼち","庵の筧に","秋雨の音"],"yomi":["かりのこす","かどたのいなば","ぬれそぼち","いおのかけいに","あきさめのおと"]},{"ban":10,"ku":["黄楊の櫛","さしても知らじ","君が手に","梳かれし髪の","今朝の乱れは"],"yomi":["つげのくし","さしてもしらじ","きみがてに","とかれしかみの","けさのみだれは"]},{"ban":14,"ku":["ともしびを","背けて聞けば","夜の雨","昔の人の","声にまじりぬ"],"yomi":["ともしびを","そむけてきけば","よるのあめ","むかしのひとの","こえにまじりぬ"]}]}
