{"poems":[{"ban":1,"ku":["吹く風の","姿を見せて","川岸の","柳の糸ぞ","靡きそめける"],"yomi":["ふくかぜの","すがたをみせて","かはぎしの","やなぎのいとぞ","なびきそめける"]},{"ban":5,"ku":["夏木立","陰深ければ","鳴く蝉の","声ばかりこそ","雨と降りけれ"],"yomi":["なつこだち","かげふかければ","なくせみの","こゑばかりこそ","あめとふりけれ"]},{"ban":9,"ku":["訪ふ人の","跡なき庭の","白雪を","踏ままく惜しみ","今朝は眺むる"],"yomi":["とふひとの","あとなきにはの","しらゆきを","ふままくをしみ","けさはながむる"]},{"ban":16,"ku":["旅人の","絶えし駅の","夕煙","誰が住む宿の","名残なるらむ"],"yomi":["たびびとの","たえしうまやの","ゆふけぶり","たがすむやどの","なごりなるらむ"]}]}
