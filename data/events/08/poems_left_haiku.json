{"poems":[{"ban":3,"ku":["蝉の声","降りしきるなり","森の奥","日は傾きて","夕暮れ近し"],"yomi":["せみのこえ","ふりしきるなり","もりのおく","ひはかたむきて","ゆうぐれちかし"]},{"ban":5,"ku":["若葉萌え","光あふるる","風の道","川辺に揺れて","夏は来にけり"],"yomi":["わかばもえ","ひかりあふるる","かぜのみち","かわべにゆれて","なつはきにけり"]},{"ban":12,"ku":["波のまに","寄る小舟こそ","君を待つ","心もさわぎ","夜ぞ深みゆく"],"yomi":["なみのまに","よるおぶねこそ","きみをまつ","こころもさわぎ","よぞふかみゆく"]},{"ban":13,"ku":["消し残す","砂に記せし","君が名は","波にも消えず","恋しさ残る"],"yomi":["けしのこす","すなにしるせし","きみがなは","なみにもきえず","こいしさのこる"]}]}
