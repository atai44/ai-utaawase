{"poems":[{"ban":2,"ku":["藤波の","揺れて匂へる","春の日に","夕べの風も","紫に染む"],"yomi":["ふじなみの","ゆれてにおへる","はるのひに","ゆうべのかぜも","むらさきにしむ"]},{"ban":7,"ku":["浦明けて","霧晴れわたる","沖つ舟","帆影ほのかに","秋の白波"],"yomi":["うらあけて","きりはれわたる","おきつふね","ほかげほのかに","あきのしらなみ"]},{"ban":11,"ku":["夕さると","待つ人来ぬに","風ぞ吹く","袖の露さへ","恋しきものを"],"yomi":["ゆうさると","まつひとこぬに","かぜぞふく","そでのつゆさへ","こいしきものを"]},{"ban":13,"ku":["書き消さぬ","砂の上なる","名は残り","波の寄すれど","恋ぞ消えぬる"],"yomi":["かきけさぬ","すなのうへなる","なはのこり","なみのよすれど","こいぞきえぬる"]}]}
