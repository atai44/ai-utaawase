{"poems":[{"ban":3,"ku":["降りやまぬ","蝉の時雨に","立ちつくす","影さえ音に","染まる昼かな"],"yomi":["ふりやまぬ","せみのしぐれに","たちつくす","かげさえおとに","そまるひるかな"]},{"ban":6,"ku":["野分過ぎ","庭に散りしく","青き葉の","空あらはなる","朝のしづけさ"],"yomi":["のわきすぎ","にわにちりしく","あおきはの","そらあらわなる","あさのしずけさ"]},{"ban":10,"ku":["夜もすがら","軒打つ音は","時雨かと","思へば庭の","落葉なりけり"],"yomi":["よもすがら","のきうつおとは","しぐれかと","おもえばにわの","おちばなりけり"]},{"ban":14,"ku":["来ぬ人を","待つとせし間に","更けぬれば","恨む心も","月に溶けつつ"],"yomi":["こぬひとを","まつとせしまに","ふけぬれば","うらむこころも","つきにとけつつ"]}]}
