{"poems":[
{"ban":2,"ku":["池水に","影をうつして","藤波の","立ちかへるべき","春ならなくに"],"yomi":["いけみずに","かげをうつして","ふじなみの","たちかえるべき","はるならなくに"]},
{"ban":8,"ku":["柴の戸を","さしもとざさぬ","山里は","月こそ秋の","あるじなりけれ"],"yomi":["しばのとを","さしもとざさぬ","やまざとは","つきこそあきの","あるじなりけれ"]},
{"ban":9,"ku":["移ろふも","色ぞまされる","白菊は","霜の下にも","秋を残して"],"yomi":["うつろうも","いろぞまされる","しらぎくは","しものしたにも","あきをのこして"]},
{"ban":14,"ku":["来ぬ人を","恨みもはてぬ","鐘の音に","明けゆく空ぞ","涙なりける"],"yomi":["こぬひとを","うらみもはてぬ","かねのねに","あけゆくそらぞ","なみだなりける"]}
]}
