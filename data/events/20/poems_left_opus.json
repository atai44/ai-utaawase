{"poems":[
{"ban":4,"ku":["秋霧の","立ち舞ふ峰の","絶え間より","洩れてさやけき","夜半の月影"],"yomi":["あきぎりの","たちまふみねの","たえまより","もれてさやけき","よはのつきかげ"]},
{"ban":6,"ku":["霜枯れの","浅茅が原の","きりぎりす","声も秋とや","ともに暮るらむ"],"yomi":["しもがれの","あさぢがはらの","きりぎりす","こゑもあきとや","ともにくるらむ"]},
{"ban":9,"ku":["朝まだき","行き来の跡も","まだ見えず","宇治の橋姫","霜や敷くらむ"],"yomi":["あさまだき","ゆききのあとも","まだみえず","うぢのはしひめ","しもやしくらむ"]},
{"ban":15,"ku":["苔むせる","古き井筒の","水清み","昔の影を","映してぞ見る"],"yomi":["こけむせる","ふるきゐづつの","みづきよみ","むかしのかげを","うつしてぞみる"]}
]}
