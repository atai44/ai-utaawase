{"poems":[{"ban":2,"ku":["夢路にも","逢ふと見るまに","明けにけり","枕に残る","夏の夜の月"],"yomi":["ゆめじにも","あうとみるまに","あけにけり","まくらにのこる","なつのよのつき"]},{"ban":8,"ku":["かきくらす","雪の交野の","御狩場に","鈴の音ばかり","空に聞こゆる"],"yomi":["かきくらす","ゆきのかたのの","みかりばに","すずのねばかり","そらにきこゆる"]},{"ban":9,"ku":["有明の","月影寒き","宇治橋に","人より先に","霜ぞ渡れる"],"yomi":["ありあけの","つきかげさむき","うじばしに","ひとよりさきに","しもぞわたれる"]},{"ban":16,"ku":["人多き","市の巷に","住みながら","心ひとつは","山の奥なる"],"yomi":["ひとおおき","いちのちまたに","すみながら","こころひとつは","やまのおくなる"]}]}
