{"poems":[{"ban":2,"ku":["夏の夜の","明くるも早く","鳴く鳥に","夢のなごりを","惜しむ間もなし"],"yomi":["なつのよの","あくるもはやく","なくとりに","ゆめのなごりを","おしむまもなし"]},{"ban":7,"ku":["山里の","柴の戸ざしに","雪降れば","煙ひとすじ","夕暮れの空"],"yomi":["やまざとの","しばのとざしに","ゆきふれば","けぶりひとすじ","ゆうぐれのそら"]},{"ban":11,"ku":["降る雨に","傘をかたみと","差し交はし","濡れし袖こそ","乾かざりけれ"],"yomi":["ふるあめに","かさをかたみと","さしかわし","ぬれしそでこそ","かわかざりけれ"]},{"ban":13,"ku":["神垣に","結ぶ祈りの","甲斐もなく","恋しき人は","遠ざかりゆく"],"yomi":["かみがきに","むすぶいのりの","かいもなく","こいしきひとは","とおざかりゆく"]}]}
