{"poems":[{"ban":1,"ku":["雲かとも","見えて動かぬ","白妙は","遠山の端の","桜なりけり"],"yomi":["くもかとも","みえてうごかぬ","しろたえは","とおやまのはの","さくらなりけり"]},{"ban":6,"ku":["鳴き弱る","虫の音ひとつ","残しつつ","秋は籬を","過ぎてゆくなり"],"yomi":["なきよわる","むしのねひとつ","のこしつつ","あきはまがきを","すぎてゆくなり"]},{"ban":11,"ku":["ひとつ傘","分けし夕べの","雨の音を","君なき肩の","濡れて聞くかな"],"yomi":["ひとつがさ","わけしゆうべの","あめのねを","きみなきかたの","ぬれてきくかな"]},{"ban":14,"ku":["母の背に","聞きし子守の","歌の節","忘れて久し","声は残れど"],"yomi":["ははのせに","ききしこもりの","うたのふし","わすれてひさし","こえはのこれど"]}]}
