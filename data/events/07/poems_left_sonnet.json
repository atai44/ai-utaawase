{"poems":[{"ban":2,"ku":["春雨に","濡れてなほ咲く","桜花","散らすなと言ふ","心ひとつに"],"yomi":["はるさめに","ぬれてなほさく","さくらばな","ちらすなといふ","こころひとつに"]},{"ban":8,"ku":["冬の夜の","冴ゆる光に","霜白く","凍れる庭の","影ぞ寂しき"],"yomi":["ふゆのよの","さゆるひかりに","しもしろく","こほれるにはの","かげぞさびしき"]},{"ban":11,"ku":["契りてし","後のつれなき","夕暮れに","待つとも言はず","待つぞ苦しき"],"yomi":["ちぎりてし","のちのつれなき","ゆふぐれに","まつともいはず","まつぞくるしき"]},{"ban":14,"ku":["行く水の","帰らぬものと","知りながら","せき止めがたき","思ひなりけり"],"yomi":["ゆくみづの","かへらぬものと","しりながら","せきとめがたき","おもひなりけり"]}]}
