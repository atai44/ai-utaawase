{"poems":[{"ban":3,"ku":["日影さす","軒端の梅は","ほころびて","北の垣根に","残る白雪"],"yomi":["ひかげさす","のきばのうめは","ほころびて","きたのかきねに","のこるしらゆき"]},{"ban":7,"ku":["風わたる","野辺の草葉の","露ごとに","宿りてぞ散る","秋の夜の月"],"yomi":["かぜわたる","のべのくさばの","つゆごとに","やどりてぞちる","あきのよのつき"]},{"ban":10,"ku":["網代木に","いさよふ波の","音さえて","宇治の川瀬に","冬は来にけり"],"yomi":["あじろぎに","いさようなみの","おとさえて","うじのかわせに","ふゆはきにけり"]},{"ban":16,"ku":["漕ぎ出でて","沖より見れば","故郷の","山は霞に","なりにけるかな"],"yomi":["こぎいでて","おきよりみれば","ふるさとの","やまはかすみに","なりにけるかな"]}]}
