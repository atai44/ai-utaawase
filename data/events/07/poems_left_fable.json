{"poems":[{"ban":1,"ku":["山の端は","まだ明けやらぬ","薄墨に","花の色のみ","まづ白みゆく"],"yomi":["やまのはは","まだあけやらぬ","うすずみに","はなのいろのみ","まづしらみゆく"]},{"ban":5,"ku":["踏み分くる","跡なき庭の","蓬生に","月を宿して","露ぞこぼるる"],"yomi":["ふみわくる","あとなきにはの","よもぎふに","つきをやどして","つゆぞこぼるる"]},{"ban":12,"ku":["忘れじと","言ひし言の葉","枯れはてて","恨みばかりぞ","身に残りける"],"yomi":["わすれじと","いひしことのは","かれはてて","うらみばかりぞ","みにのこりける"]},{"ban":15,"ku":["松風を","友と定めて","住む庵は","訪はれぬことも","嬉しかりけり"],"yomi":["まつかぜを","ともとさだめて","すむいほは","とはれぬことも","うれしかりけり"]}]}
