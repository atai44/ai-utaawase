{"poems":[
{"ban":1,"ku":["ほのぼのと","霞に沈む","山の端の","花より白む","春の曙"],"yomi":["ほのぼのと","かすみにしづむ","やまのはの","はなよりしらむ","はるのあけぼの"]},
{"ban":6,"ku":["吹き荒れし","名残の露を","払ひかね","伏したる萩に","残る月影"],"yomi":["ふきあれし","なごりのつゆを","はらひかね","ふしたるはぎに","のこるつきかげ"]},
{"ban":10,"ku":["宇治川の","網代の波も","冴えかへり","寄る氷魚さへや","冬を知るらむ"],"yomi":["うぢがはの","あじろのなみも","さえかへり","よるひをさへや","ふゆをしるらむ"]},
{"ban":14,"ku":["堰きとめて","人に知られぬ","山水の","下に流るる","我が涙かな"],"yomi":["せきとめて","ひとにしられぬ","やまみづの","したにながるる","わがなみだかな"]}
]}
