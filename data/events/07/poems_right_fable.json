{"poems":[{"ban":2,"ku":["春雨の","糸につらぬく","白玉を","枝にとどめて","咲く桜かな"],"yomi":["はるさめの","いとにつらぬく","しらたまを","えだにとどめて","さくさくらかな"]},{"ban":7,"ku":["秋の野の","草葉における","白露は","ひとつひとつに","月ぞやどれる"],"yomi":["あきののの","くさばにおける","しらつゆは","ひとつひとつに","つきぞやどれる"]},{"ban":9,"ku":["小野山や","雪にうもるる","炭竈の","細きけぶりぞ","人目なりける"],"yomi":["をのやまや","ゆきにうもるる","すみがまの","ほそきけぶりぞ","ひとめなりける"]},{"ban":15,"ku":["訪ふ人も","なき山里の","柴の戸に","松風ばかり","おとづれにけり"],"yomi":["とふひとも","なきやまざとの","しばのとに","まつかぜばかり","おとづれにけり"]}]}
