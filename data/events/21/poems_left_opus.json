{"poems":[{"ban":1,"ku":["入日さす","霞の底に","声ばかり","残して雲雀","野辺に落ちゆく"],"yomi":["いりひさす","かすみのそこに","こえばかり","のこしてひばり","のべにおちゆく"]},{"ban":5,"ku":["秋の田の","穂波そよぎて","吹く風に","仮庵の苫も","露ぞこぼるる"],"yomi":["あきのたの","ほなみそよぎて","ふくかぜに","かりいほのとまも","つゆぞこぼるる"]},{"ban":10,"ku":["来ぬ人を","待つ夜の月の","つれなさよ","我が袖にのみ","影を宿して"],"yomi":["こぬひとを","まつよのつきの","つれなさよ","わがそでにのみ","かげをやどして"]},{"ban":14,"ku":["草枕","夜ごとに変はる","宿なれど","同じ影なる","ふるさとの月"],"yomi":["くさまくら","よごとにかはる","やどなれど","おなじかげなる","ふるさとのつき"]}]}
