{"poems":[{"ban":3,"ku":["夏の夜や","遠雷ひびき","蚊遣り火も","窓の向こうに","雨の気配す"],"yomi":["なつのよや","えんらいひびき","かやりびも","まどのむこうに","あめのけはいす"]},{"ban":5,"ku":["秋の田の","仮庵に宿る","露しとど","稲穂の波に","月ぞ照らせる"],"yomi":["あきのたの","かりほにやどる","つゆしとど","いなほのなみに","つきぞてらせる"]},{"ban":9,"ku":["雪の野に","鷹放ちけり","羽ばたきて","獲物を追へば","雪けぶり立つ"],"yomi":["ゆきののに","たかはなちけり","はばたきて","えものをおへば","ゆきけぶりたつ"]},{"ban":13,"ku":["貸せし傘","君の濡れゆく","雨の道","別れ路に我","また会ふ日まで"],"yomi":["かせしかさ","きみのぬれゆく","あめのみち","わかれじにわれ","またあふひまで"]}]}
