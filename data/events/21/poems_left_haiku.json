{"poems":[{"ban":2,"ku":["春野原","雲雀昇りて","声高く","空に溶けゆく","光の中へ"],"yomi":["はるのはら","ひばりのぼりて","こえたかく","そらにとけゆく","ひかりのなかへ"]},{"ban":6,"ku":["実りたる","稲穂の波の","たわわなり","風にゆられて","秋の日差しよ"],"yomi":["みのりたる","いなほのなみの","たわわなり","かぜにゆられて","あきのひざしよ"]},{"ban":9,"ku":["白銀の","雪原走る","鷹の影","一閃にして","獲物を掴む"],"yomi":["しろがねの","せつげんはしる","たかのかげ","ひとせんにして","えものをつかむ"]},{"ban":15,"ku":["夜の海に","ぽつりぽつりと","漁火の","揺れて星なす","波に映りて"],"yomi":["よるのうみに","ぽつりぽつりと","いさりびの","ゆれてほしなす","なみにうつりて"]}]}
