{"poems":[{"ban":1,"ku":["空高く","声ふるはせて","昇りつつ","茜の雲に","とけゆくひばり"],"yomi":["そらたかく","こゑふるはせて","のぼりつつ","あかねのくもに","とけゆくひばり"]},{"ban":8,"ku":["霜枯れの","庭にひとえだ","ほころびて","寒きひかりに","梅の香ぞ立つ"],"yomi":["しもがれの","にはにひとえだ","ほころびて","さむきひかりに","うめのかぞたつ"]},{"ban":12,"ku":["急ぎ来て","軒端に君と","並びたる","雨よこのまま","降りやまずあれ"],"yomi":["いそぎきて","のきばにきみと","ならびたる","あめよこのまま","ふりやまずあれ"]},{"ban":15,"ku":["夜の海に","星かとまがふ","いさり火の","ひとつ消えては","波にゆれけり"],"yomi":["よのうみに","ほしかとまがふ","いさりびの","ひとつきえては","なみにゆれけり"]}]}
