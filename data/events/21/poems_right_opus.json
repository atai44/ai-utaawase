{"poems":[
{"ban":4,"ku":["藻塩焼く","煙も絶えて","須磨の浦","波にやどれる","秋の夜の月"],"yomi":["もしほやく","けぶりもたえて","すまのうら","なみにやどれる","あきのよのつき"]},
{"ban":6,"ku":["小山田の","稲葉色づく","夕暮れに","穂波をわたる","秋風の声"],"yomi":["をやまだの","いなばいろづく","ゆふぐれに","ほなみをわたる","あきかぜのこゑ"]},
{"ban":10,"ku":["来ぬ人を","待つ夜の月の","つれなさよ","我が袖にのみ","影を宿して"],"yomi":["こぬひとを","まつよのつきの","つれなさよ","わがそでにのみ","かげをやどして"]},
{"ban":16,"ku":["巣立ちたる","子らの丈なる","柱傷","撫づれば遠き","夏の日の声"],"yomi":["すだちたる","こらのたけなる","はしらきず","なづればとほき","なつのひのこゑ"]}
]}
