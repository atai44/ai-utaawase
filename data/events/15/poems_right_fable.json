{"poems":[{"ban":2,"ku":["むすぶ手の","しづくに月の","影落ちて","夏をばよそに","聞く泉かな"],"yomi":["むすぶての","しづくにつきの","かげおちて","なつをばよそに","きくいづみかな"]},{"ban":8,"ku":["岩間ゆく","水のひびきは","とぢはてて","氷のうへに","月ぞ更けゆく"],"yomi":["いはまゆく","みづのひびきは","とぢはてて","こほりのうへに","つきぞふけゆく"]},{"ban":12,"ku":["返しやる","衣はかろし","移り香の","しみにし袖を","いかが返さむ"],"yomi":["かへしやる","ころもはかろし","うつりがの","しみにしそでを","いかがかへさむ"]},{"ban":13,"ku":["言はでのみ","年ふる石の","苔の下","思ひの水は","絶えずもるかな"],"yomi":["いはでのみ","としふるいしの","こけのした","おもひのみづは","たえずもるかな"]}]}
