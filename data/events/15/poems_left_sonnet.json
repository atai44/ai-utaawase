{"poems":[{"ban":1,"ku":["春雨の","ふるともなしに","けぶる野に","梅のにほひぞ","かすかに残る"],"yomi":["はるさめの","ふるともなしに","けぶるのに","うめのにほひぞ","かすかにのこる"]},{"ban":7,"ku":["朝日さす","軒の氷柱の","しづくごと","とけゆく冬を","惜しむ音かな"],"yomi":["あさひさす","のきのつららの","しづくごと","とけゆくふゆを","おしむおとかな"]},{"ban":12,"ku":["返さんと","包む形見の","袖の香に","残る涙を","添へてやるかな"],"yomi":["かへさんと","つつむかたみの","そでのかに","のこるなみだを","そへてやるかな"]},{"ban":14,"ku":["夕づく日","江のおもてゆく","白帆かげ","遠くなるほど","波にまがひぬ"],"yomi":["ゆふづくひ","えのおもてゆく","しらほかげ","とほくなるほど","なみにまがひぬ"]}]}
