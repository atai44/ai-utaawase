{"poems":[{"ban":4,"ku":["朝霧の","深き入江を","出づる舟","楫音ばかり","沖へ遠のく"],"yomi":["あさぎりの","ふかきいりえを","いづるふね","かぢおとばかり","おきへとほのく"]},{"ban":8,"ku":["夜もすがら","鳴りし瀬音を","閉ぢこめて","氷は白く","朝を迎ふる"],"yomi":["よもすがら","なりしせおとを","とぢこめて","こほりはしろく","あさをむかふる"]},{"ban":9,"ku":["枯れ残る","庭の柞に","音立てて","過ぎゆくものは","初時雨かな"],"yomi":["かれのこる","にはのははそに","おとたてて","すぎゆくものは","はつしぐれかな"]},{"ban":16,"ku":["旅人の","影もろともに","暮れてゆく","瀬田の長橋","夕波の音"],"yomi":["たびびとの","かげもろともに","くれてゆく","せたのながはし","ゆふなみのおと"]}]}
