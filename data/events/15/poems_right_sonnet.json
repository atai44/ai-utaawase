{"poems":[
{"ban":1,"ku":["降る音も","聞こえぬほどの","春雨に","軒の梅が枝","色まさりけり"],"yomi":["ふるおとも","きこえぬほどの","はるさめに","のきのうめがえ","いろまさりけり"]},
{"ban":5,"ku":["小夜更けて","枕のもとに","鳴く鹿の","声に覚めぬる","秋の夢かな"],"yomi":["さよふけて","まくらのもとに","なくしかの","こゑにさめぬる","あきのゆめかな"]},
{"ban":11,"ku":["鐘の音に","君が帰りを","思ふ間も","明けゆく空の","つらく聞こゆる"],"yomi":["かねのねに","きみがかへりを","おもふまも","あけゆくそらの","つらくきこゆる"]},
{"ban":16,"ku":["夕暮れの","橋の半ばを","行く人の","影ながく引く","川の面かな"],"yomi":["ゆふぐれの","はしのなかばを","ゆくひとの","かげながくひく","かわのもかな"]}
]}
