{"poems":[{"ban":4,"ku":["誰を待つ","宿ともなきを","暁の","水鶏は叩く","槙の板戸を"],"yomi":["たれをまつ","やどともなきを","あかつきの","くひなはたたく","まきのいたどを"]},{"ban":7,"ku":["招くとも","見えて乱るる","花薄","風の心を","誰に問はまし"],"yomi":["まねくとも","みえてみだるる","はなすすき","かぜのこころを","たれにとはまし"]},{"ban":9,"ku":["訪ふ人の","跡さへ惜しき","庭の雪","待たれし頃の","心ならねど"],"yomi":["とふひとの","あとさへをしき","にはのゆき","またれしころの","こころならねど"]},{"ban":16,"ku":["草枕","結びもあへぬ","夕嵐","都の夢を","いづち吹くらむ"],"yomi":["くさまくら","むすびもあへぬ","ゆふあらし","みやこのゆめを","いづちふくらむ"]}]}
