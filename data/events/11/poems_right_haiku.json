{"poems":[{"ban":3,"ku":["雨上がり","露を宿して","紅の","花弁ゆらぐ","夏風そよぐ"],"yomi":["あめあがり","つゆをやどして","くれないの","はなびらゆらぐ","なつかぜそよぐ"]},{"ban":6,"ku":["庭の面に","ふと涼しさの","秋来ぬと","風のさやけさ","桐一葉落つ"],"yomi":["にわのおもに","ふとすずしさの","あききぬと","かぜのさやけさ","きりひとはおつ"]},{"ban":12,"ku":["面影は","消えて声のみ","残りつつ","夜ごと夢路に","わが名呼ぶ声"],"yomi":["おもかげは","きえてこえのみ","のこりつつ","よごとゆめじに","わがなよぶこえ"]},{"ban":13,"ku":["降る雪に","思ひを寄せて","消えぬ間を","待つとも知らず","君は来ずして"],"yomi":["ふるゆきに","おもひをよせて","きえぬまを","まつともしらず","きみはこずして"]}]}
