{"poems":[
{"ban":1,"ku":["梅が香を","袖にとどめて","立ちつくす","春の夜風の","ゆくへ知らずも"],"yomi":["うめがかを","そでにとどめて","たちつくす","はるのよかぜの","ゆくえしらずも"]},
{"ban":7,"ku":["朝霧の","深き底より","聞こえくる","声にあはれを","知る小牡鹿"],"yomi":["あさぎりの","ふかきそこより","きこえくる","こえにあわれを","しるさおしか"]},
{"ban":9,"ku":["時雨ゆく","杣の梢の","雲間より","濡れたる色の","冬を見せけり"],"yomi":["しぐれゆく","そまのこずえの","くもまより","ぬれたるいろの","ふゆをみせけり"]},
{"ban":16,"ku":["荒れ寺の","消え残る灯を","たよりにて","昔の人の","影を偲ばむ"],"yomi":["あれでらの","きえのこるひを","たよりにて","むかしのひとの","かげをしのばむ"]}
]}
