{"poems":[{"ban":3,"ku":["越えなづむ","岩のかけ路に","咲く藤の","花にぞ春の","日は暮れにける"],"yomi":["こえなづむ","いはのかけぢに","さくふぢの","はなにぞはるの","ひはくれにける"]},{"ban":7,"ku":["妻恋ふる","声ばかりして","さを鹿の","姿は霧に","立ちこめられぬ"],"yomi":["つまこふる","こゑばかりして","さをしかの","すがたはきりに","たちこめられぬ"]},{"ban":12,"ku":["秋風に","忘らるる身は","置く扇","逢ふ名ばかりを","頼みけるかな"],"yomi":["あきかぜに","わすらるるみは","おくあふぎ","あふなばかりを","たのみけるかな"]},{"ban":13,"ku":["返しなき","文の数のみ","積もりつつ","涙に墨の","跡ぞ流るる"],"yomi":["かへしなき","ふみのかずのみ","つもりつつ","なみだにすみの","あとぞながるる"]}]}
