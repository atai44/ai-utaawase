{"poems":[
{"ban":1,"ku":["梅が香や","袖にとまりて","夜もすがら","君が訪ひ来る","心地こそすれ"],"yomi":["うめがかや","そでにとまりて","よもすがら","きみがとひくる","ここちこそすれ"]},
{"ban":5,"ku":["五月雨の","軒の雫の","絶え間なく","物思ふ身の","袖ぞ濡れゆく"],"yomi":["さみだれの","のきのしずくの","たえまなく","ものおもうみの","そでぞぬれゆく"]},
{"ban":10,"ku":["降る雪に","道も跡なき","夕暮れを","戸ざしもやらで","君を待つかな"],"yomi":["ふるゆきに","みちもあとなき","ゆうぐれを","とざしもやらで","きみをまつかな"]},
{"ban":14,"ku":["ふるさとは","変はらぬ山の","姿のみ","昔語りの","人ぞ恋しき"],"yomi":["ふるさとは","かわらぬやまの","すがたのみ","むかしがたりの","ひとぞこいしき"]}
]}
