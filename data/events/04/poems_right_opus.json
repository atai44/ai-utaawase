{"poems":[{"ban":4,"ku":["月もなき","五月の闇の","夜もすがら","昔をかへす","軒の橘"],"yomi":["つきもなき","さつきのやみの","よもすがら","むかしをかへす","のきのたちばな"]},{"ban":5,"ku":["見る人も","なき奥山の","もみぢ葉は","誰がために染む","秋の錦ぞ"],"yomi":["みるひとも","なきおくやまの","もみぢばは","たがためにそむ","あきのにしきぞ"]},{"ban":11,"ku":["忘れじと","言ひし言の葉","いつの間に","秋の木の葉と","なりて散りけむ"],"yomi":["わすれじと","いひしことのは","いつのまに","あきのこのはと","なりてちりけむ"]},{"ban":16,"ku":["鐘の音に","夜はしらみゆく","山寺の","窓にのこれる","法のともしび"],"yomi":["かねのおとに","よはしらみゆく","やまでらの","まどにのこれる","のりのともしび"]}]}
