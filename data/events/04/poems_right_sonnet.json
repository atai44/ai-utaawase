{"poems":[
{"ban":1,"ku":["梅が香を","のせて吹きくる","夕風に","まだ見ぬ宿の","春を知るかな"],"yomi":["うめがかを","のせてふきくる","ゆうかぜに","まだみぬやどの","はるをしるかな"]},
{"ban":8,"ku":["霜夜ふけ","空澄みわたる","冬の月","氷の色に","影ぞ冴えゆく"],"yomi":["しもよふけ","そらすみわたる","ふゆのつき","こおりのいろに","かげぞさえゆく"]},
{"ban":10,"ku":["書きかはす","言の葉もいま","絶えはてて","かたみに残る","墨のかなしさ"],"yomi":["かきかわす","ことのはもいま","たえはてて","かたみにのこる","すみのかなしさ"]},
{"ban":14,"ku":["訪ふ人も","なき山寺の","石段に","苔むす色の","深き静けさ"],"yomi":["とうひとも","なきやまでらの","いしだんに","こけむすいろの","ふかきしずけさ"]}
]}
