{"poems":[
{"ban":1,"ku":["梅が香を","のせて吹きくる","春風に","軒端の袖も","染まりぬるかな"],"yomi":["うめがかを","のせてふきくる","はるかぜに","のきばのそでも","そまりぬるかな"]},
{"ban":6,"ku":["山守の","染めし錦を","おのづから","水に織りなす","秋の川波"],"yomi":["やまもりの","そめしにしきを","おのづから","みずにおりなす","あきのかわなみ"]},
{"ban":11,"ku":["思ひ出づる","ことさへ今は","うすれゆき","君が名のみぞ","夢に残れる"],"yomi":["おもひいづる","ことさへいまは","うすれゆき","きみがなのみぞ","ゆめにのこれる"]},
{"ban":15,"ku":["夕霞","たなびく果ての","山の端に","ふるさと遠く","煙立つ見ゆ"],"yomi":["ゆふがすみ","たなびくはての","やまのはに","ふるさととほく","けぶりたつみゆ"]}
]}
