{"poems":[{"ban":2,"ku":["花の下","立つ影ながく","なりぬれど","帰る道をば","われ忘れつつ"],"yomi":["はなのした","たつかげながく","なりぬれど","かへるみちをば","われわすれつつ"]},{"ban":5,"ku":["寝覚めして","数ふる鐘の","遠けれど","明けぬ夜長を","虫と明かさむ"],"yomi":["ねざめして","かぞふるかねの","とほけれど","あけぬよながを","むしとあかさむ"]},{"ban":9,"ku":["降る雪の","重みに堪へぬ","竹の声","夜の静けさ","裂きて折れけり"],"yomi":["ふるゆきの","おもみにたへぬ","たけのこゑ","よのしづけさ","さきてをれけり"]},{"ban":15,"ku":["雨の夜の","灯火細く","かき立てて","昔の人の","言の葉を読む"],"yomi":["あめのよの","ともしびほそく","かきたてて","むかしのひとの","ことのはをよむ"]}]}
