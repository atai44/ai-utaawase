{"poems":[{"ban":1,"ku":["待ちわびし","梢の色に","初花の","ひらくを見れば","春は来にけり"],"yomi":["まちわびし","こずえのいろに","はつはなの","ひらくをみれば","はるはきにけり"]},{"ban":7,"ku":["あさ露を","分けゆく袖の","重ければ","衣の色も","秋ぞ深しき"],"yomi":["あさつゆを","わけゆくそでの","おもければ","ころものいろも","あきぞふかしき"]},{"ban":9,"ku":["夜もすがら","竹のしづ枝の","折るる音","雪の重さを","思ひ知るかな"],"yomi":["よもすがら","たけのしづえの","おるるおと","ゆきのおもさを","おもいしるかな"]},{"ban":13,"ku":["ほのかにも","遠き呼び声","聞きしより","眠れぬ夜ごと","君を恋ふらむ"],"yomi":["ほのかにも","とおきよびごえ","ききしより","ねむれぬよごと","きみをこふらむ"]}]}
