{"poems":[{"ban":3,"ku":["短夜の","夢はあとなき","枕辺に","誰が袖の香ぞ","橘の風"],"yomi":["みじかよの","ゆめはあとなき","まくらべに","たがそでのかぞ","たちばなのかぜ"]},{"ban":8,"ku":["散り敷ける","庭の紅葉の","色ながら","薄く隔つる","今朝の初霜"],"yomi":["ちりしける","にはのもみぢの","いろながら","うすくへだつる","けさのはつしも"]},{"ban":10,"ku":["言はで経し","年の数だに","知られじな","袖の下行く","水の心は"],"yomi":["いはでへし","としのかずだに","しられじな","そでのしたゆく","みづのこころは"]},{"ban":13,"ku":["川霧の","をちかた人の","呼ぶ声を","わが名と聞きて","袖ぞ濡れける"],"yomi":["かはぎりの","をちかたびとの","よぶこゑを","わがなとききて","そでぞぬれける"]}]}
