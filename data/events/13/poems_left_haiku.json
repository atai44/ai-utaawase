{"poems":[{"ban":1,"ku":["春来ぬと","山のかげより","咲きそめし","桜の花の","色ぞ初めて"],"yomi":["はるきぬと","やまのかげより","さきそめし","さくらのはなの","いろぞはじめて"]},{"ban":6,"ku":["秋ふかく","暮れゆく空の","雁がねも","今はかぎりと","鳴き渡るらし"],"yomi":["あきふかく","くれゆくそらの","かりがねも","いまはかぎりと","なきわたるらし"]},{"ban":11,"ku":["逢ふほどに","増さるこころの","深き淵","底しらぬまで","身をぞ沈めし"],"yomi":["あふほどに","まさるこころの","ふかきふち","そこしらぬまで","みをぞしずめし"]},{"ban":14,"ku":["里の戸に","夕げの煙","立ちのぼる","秋のみのりを","炊くぞ嬉しき"],"yomi":["さとのとに","ゆうげのけむり","たちのぼる","あきのみのりを","たくぞうれしき"]}]}
