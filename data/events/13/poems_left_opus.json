{"poems":[{"ban":4,"ku":["夕されば","賤が垣根に","咲きいでて","誰をか待たむ","白き夕顔"],"yomi":["ゆふされば","しづがかきねに","さきいでて","たれをかまたむ","しろきゆふがほ"]},{"ban":7,"ku":["秋の野の","千草の露を","分けゆけば","袖に移れる","萩が花摺り"],"yomi":["あきののの","ちくさのつゆを","わけゆけば","そでにうつれる","はぎがはなずり"]},{"ban":12,"ku":["頼めつる","人は来ずして","山の端に","待たぬ月のみ","かたぶきにけり"],"yomi":["たのめつる","ひとはこずして","やまのはに","またぬつきのみ","かたぶきにけり"]},{"ban":16,"ku":["いにしへの","友と語らふ","夢覚めて","枕に残る","有明の月"],"yomi":["いにしへの","ともとかたらふ","ゆめさめて","まくらにのこる","ありあけのつき"]}]}
