{"poems":[{"ban":2,"ku":["散りまがふ","花の下かげ","道絶えて","暮るるも知らず","春の山人"],"yomi":["ちりまがふ","はなのしたかげ","みちたえて","くるるもしらず","はるのやまびと"]},{"ban":8,"ku":["夜もすがら","吹きしく風の","跡見えて","落葉に白き","今朝の初霜"],"yomi":["よもすがら","ふきしくかぜの","あとみえて","おちばにしろき","けさのはつしも"]},{"ban":12,"ku":["頼めおく","宵はいつしか","更けにけり","待たぬ月のみ","窓に入り来て"],"yomi":["たのめおく","よひはいつしか","ふけにけり","またぬつきのみ","まどにいりきて"]},{"ban":14,"ku":["小山田の","刈穂のあとの","夕まぐれ","賤が伏屋に","煙立つなり"],"yomi":["をやまだの","かりほのあとの","ゆふまぐれ","しづがふせやに","けぶりたつなり"]}]}
