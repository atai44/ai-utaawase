{"poems":[{"ban":3,"ku":["夏山の","繁みが奥に","冬籠る","氷室の雪は","蝉も知らじな"],"yomi":["なつやまの","しげみがおくに","ふゆごもる","ひむろのゆきは","せみもしらじな"]},{"ban":6,"ku":["絶え絶えに","遠里小野の","衣打つ","音を運びて","秋風ぞ吹く"],"yomi":["たえだえに","とほざとをのの","ころもうつ","おとをはこびて","あきかぜぞふく"]},{"ban":9,"ku":["霜枯れの","蘆の折れ葉に","風さえて","入江の波ぞ","凍りつつ寄る"],"yomi":["しもがれの","あしのをれはに","かぜさえて","いりえのなみぞ","こほりつつよる"]},{"ban":14,"ku":["人知れぬ","思ひは富士の","嶺ならで","煙も立てず","燃えわたるかな"],"yomi":["ひとしれぬ","おもひはふじの","みねならで","けぶりもたてず","もえわたるかな"]}]}
