{"poems":[{"ban":2,"ku":["行く春を","とどめもあへず","山吹の","散りしく岸に","暮るる川波"],"yomi":["ゆくはるを","とどめもあへず","やまぶきの","ちりしくきしに","くるるかはなみ"]},{"ban":7,"ku":["長月の","夜寒の空に","澄みのぼる","名残の月に","菊の香ぞする"],"yomi":["ながつきの","よさむのそらに","すみのぼる","なごりのつきに","きくのかぞする"]},{"ban":9,"ku":["難波江の","葦の枯れ葉に","霜さえて","汀の波ぞ","夜半に凍れる"],"yomi":["なにはえの","あしのかれはに","しもさえて","みぎはのなみぞ","よはにこほれる"]},{"ban":15,"ku":["独り居の","窓のともしび","かすかにて","夜深き鐘の","声ぞ身にしむ"],"yomi":["ひとりゐの","まどのともしび","かすかにて","よぶかきかねの","こゑぞみにしむ"]}]}
