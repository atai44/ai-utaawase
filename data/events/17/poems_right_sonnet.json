{"poems":[{"ban":1,"ku":["花の下","暮れゆく空を","惜しみつつ","立ちやすらへば","日は入りにけり"],"yomi":["はなのした","くれゆくそらを","おしみつつ","たちやすらへば","ひはいりにけり"]},{"ban":7,"ku":["名残とて","仰ぐ夜更けの","後の月","欠けたる影に","秋ぞ深まる"],"yomi":["なごりとて","あおぐよふけの","のちのつき","かけたるかげに","あきぞふかまる"]},{"ban":12,"ku":["言ひさして","袖に隠せし","唇の","続きを知らぬ","夜の長さよ"],"yomi":["いひさして","そでにかくせし","くちびるの","つづきをしらぬ","よのながさよ"]},{"ban":13,"ku":["帰りゆく","袖の移り香","消えぬ間に","文の使ひを","待つ朝かな"],"yomi":["かへりゆく","そでのうつりが","きえぬまに","ふみのつかひを","まつあしたかな"]}]}
