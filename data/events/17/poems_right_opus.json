{"poems":[{"ban":2,"ku":["暮れはつる","弥生の空の","名残とて","散りしく花に","月ぞ宿れる"],"yomi":["くれはつる","やよいのそらの","なごりとて","ちりしくはなに","つきぞやどれる"]},{"ban":8,"ku":["霜枯れの","葦の葉そよぐ","難波江に","氷をわけて","鴨の鳴くなり"],"yomi":["しもがれの","あしのはそよぐ","なにわえに","こおりをわけて","かものなくなり"]},{"ban":11,"ku":["更くる夜の","灯火かかげ","待つ人の","来ぬにつけても","消えぬ思ひぞ"],"yomi":["ふくるよの","ともしびかかげ","まつひとの","こぬにつけても","きえぬおもいぞ"]},{"ban":16,"ku":["呉竹の","窓うつ雨の","音ばかり","世をへだてたる","夜半のしづけさ"],"yomi":["くれたけの","まどうつあめの","おとばかり","よをへだてたる","よわのしずけさ"]}]}
