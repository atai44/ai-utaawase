{"poems":[{"ban":4,"ku":["茅の輪くぐ","る夏の日ざし","身の穢れ","水に流して","風ぞ涼しき"],"yomi":["ちのわくぐ","るなつのひざし","みのけがれ","みずにながして","かぜぞすずしき"]},{"ban":5,"ku":["夕暮れや","野辺に鶉の","声ぞ添ふ","秋の草むら","露ぞこぼるる"],"yomi":["ゆうぐれや","のべにうずらの","こえぞそふ","あきのくさむら","つゆぞこぼるる"]},{"ban":10,"ku":["深山には","雪のふりしく","夕暮れの","光も白く","谷はしづけし"],"yomi":["みやまには","ゆきのふりしく","ゆうぐれの","ひかりもしろく","たにはしづけし"]},{"ban":15,"ku":["窓辺より","遠くの寺の","かすかなる","音に目覚めぬ","夜はふけにけり"],"yomi":["まどべより","とおくのてらの","かすかなる","おとにめざめぬ","よはふけにけり"]}]}
