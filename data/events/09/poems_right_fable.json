{"poems":[{"ban":1,"ku":["ふるさとの","花も待つらむ","春雨に","翼しをれて","帰るかりがね"],"yomi":["ふるさとの","はなもまつらむ","はるさめに","つばさしをれて","かへるかりがね"]},{"ban":5,"ku":["呉竹の","葉末の露に","宿る月","こぼさで過ぎよ","秋の夜の風"],"yomi":["くれたけの","はずゑのつゆに","やどるつき","こぼさですぎよ","あきのよのかぜ"]},{"ban":9,"ku":["鳥の音も","まだ聞こえこぬ","暁の","庭に木の葉の","音ぞしぐるる"],"yomi":["とりのねも","まだきこえこぬ","あかつきの","にはにこのはの","おとぞしぐるる"]},{"ban":16,"ku":["呼ぶ声は","川霧ふかく","消えはてて","舟待つ袖に","暮るる夕波"],"yomi":["よぶこゑは","かはぎりふかく","きえはてて","ふねまつそでに","くるるゆふなみ"]}]}
