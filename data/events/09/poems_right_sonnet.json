{"poems":[{"ban":3,"ku":["卯の花の","垣根にかかる","月の影","雪かとまがふ","夏のゆふぐれ"],"yomi":["うのはなの","かきねにかかる","つきのかげ","ゆきかとまがふ","なつのゆふぐれ"]},{"ban":6,"ku":["稲妻の","ひらめくたびに","浮かび来る","田の面の穂波","白くなりけり"],"yomi":["いなづまの","ひらめくたびに","うかびくる","たのものほなみ","しろくなりけり"]},{"ban":11,"ku":["炭竈の","煙ひとすぢ","立ちのぼる","雪の山辺の","夕暮れの空"],"yomi":["すみがまの","けぶりひとすぢ","たちのぼる","ゆきのやまべの","ゆふぐれのそら"]},{"ban":14,"ku":["満つ潮に","隔てられゆく","磯の道","君に逢ふ瀬も","袖ぞ濡れける"],"yomi":["みつしほに","へだてられゆく","いそのみち","きみにあふせも","そでぞぬれける"]}]}
