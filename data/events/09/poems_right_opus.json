{"poems":[{"ban":2,"ku":["永き日の","入り方遠き","山の端に","霞みて残る","遠の白雲"],"yomi":["ながきひの","いりがたとほき","やまのはに","かすみてのこる","をちのしらくも"]},{"ban":7,"ku":["訪ふ人も","絶えにし宿の","荻の葉に","声ばかりして","秋風ぞ吹く"],"yomi":["とふひとも","たえにしやどの","をぎのはに","こゑばかりして","あきかぜぞふく"]},{"ban":10,"ku":["霜さゆる","朝の池の","薄氷","閉ぢぬ隙にぞ","鴨の鳴くなる"],"yomi":["しもさゆる","あしたのいけの","うすごほり","とぢぬひまにぞ","かものなくなる"]},{"ban":15,"ku":["沖つ波","寄せては返る","浜松の","根を洗ひつつ","幾世経ぬらむ"],"yomi":["おきつなみ","よせてはかへる","はままつの","ねをあらひつつ","いくよへぬらむ"]}]}
