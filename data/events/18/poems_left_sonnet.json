{"poems":[
{"ban":1,"ku":["春駒の","いななく野辺に","霞立ち","若草踏みて","駆けゆくあした"],"yomi":["はるこまの","いななくのべに","かすみたち","わかくさふみて","かけゆくあした"]},
{"ban":8,"ku":["霜夜ふけ","池のおしどり","羽交ひして","凍る水面に","寄り添ひて寝る"],"yomi":["しもよふけ","いけのおしどり","はがいして","こおるみのもに","よりそひてぬる"]},
{"ban":12,"ku":["忍び音の","琴の調べに","君恋ひて","弾けば涙の","絃も濡れけり"],"yomi":["しのびねの","ことのしらべに","きみこひて","ひけばなみだの","いともぬれけり"]},
{"ban":13,"ku":["夕暮れの","空飛ぶ鳥も","帰るなり","われのみ君に","逢ふ由もなし"],"yomi":["ゆうぐれの","そらとぶとりも","かえるなり","われのみきみに","あうよしもなし"]}
]}
