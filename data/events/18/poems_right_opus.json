{"poems":[{"ban":2,"ku":["短夜の","明けやらぬ間に","遣水の","音のみ先に","白みそめけり"],"yomi":["みじかよの","あけやらぬまに","やりみずの","おとのみさきに","しらみそめけり"]},{"ban":8,"ku":["霜冴ゆる","池の汀の","薄氷","羽交ひの下は","凍らざりけり"],"yomi":["しもさゆる","いけのみぎわの","うすごおり","はがいのしたは","こおらざりけり"]},{"ban":10,"ku":["書き捨てて","出ださぬ文の","数のみぞ","逢はぬ月日の","しるしなりける"],"yomi":["かきすてて","いださぬふみの","かずのみぞ","あわぬつきひの","しるしなりける"]},{"ban":15,"ku":["住む人の","名のみ残れる","門の札","雨に薄れて","誰を待つらむ"],"yomi":["すむひとの","なのみのこれる","かどのふだ","あめにうすれて","たれをまつらむ"]}]}
