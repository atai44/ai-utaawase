{"poems":[
{"ban":3,"ku":["小雨降る","泥に裾濡れ","早乙女の","植うる苗葉に","露ぞこぼるる"],"yomi":["こさめふる","どろにすそぬれ","さおとめの","ううるなえばに","つゆぞこぼるる"]},
{"ban":5,"ku":["葛の葉の","白き裏見す","夕風に","秋のあはれを","知らせ顔なる"],"yomi":["くずのはの","しろきうらみす","ゆうかぜに","あきのあわれを","しらせがおなる"]},
{"ban":9,"ku":["散る紅葉","受けて凍れる","池の面に","錦を閉ぢし","朝の薄氷"],"yomi":["ちるもみじ","うけてこおれる","いけのもに","にしきをとじし","あさのうすらい"]},
{"ban":13,"ku":["朝ぼらけ","別れを惜しむ","鳥の音に","君が帰りの","袖ぞ濡れける"],"yomi":["あさぼらけ","わかれをおしむ","とりのねに","きみがかえりの","そでぞぬれける"]}
]}
