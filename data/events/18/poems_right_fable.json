{"poems":[{"ban":1,"ku":["雪消えの","沢の若草","あさりつつ","嘶く駒の","影ぞ霞める"],"yomi":["ゆきぎえの","さはのわかくさ","あさりつつ","いななくこまの","かげぞかすめる"]},{"ban":6,"ku":["雲ゐ路の","千里のほかの","故郷も","同じ光に","月や澄むらむ"],"yomi":["くもゐぢの","ちさとのほかの","ふるさとも","おなじひかりに","つきやすむらむ"]},{"ban":11,"ku":["幾年の","霜をかさねし","黒髪を","見かはす今宵","夢かとぞ思ふ"],"yomi":["いくとせの","しもをかさねし","くろかみを","みかはすこよひ","ゆめかとぞおもふ"]},{"ban":14,"ku":["窓ちかき","竹の葉そそぐ","夜の雨に","昔を語る","灯火の影"],"yomi":["まどちかき","たけのはそそぐ","よのあめに","むかしをかたる","ともしびのかげ"]}]}
