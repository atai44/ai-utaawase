{"poems":[{"ban":4,"ku":["夕暮れの","空にほのかな","初月の","光は秋の","風に揺れつつ"],"yomi":["ゆうぐれの","そらにほのかな","はつづきの","ひかりはあきの","かぜにゆれつつ"]},{"ban":7,"ku":["入り江には","霜に濡れたる","蘆の穂も","凍てつく水に","音なく立ちて"],"yomi":["いりえには","しもにぬれたる","あしのほも","いてつくみずに","おとなくたちて"]},{"ban":12,"ku":["琴の緒に","かけし思ひの","音は絶えず","君にひそかに","つたへてしかな"],"yomi":["ことのおに","かけしおもひの","ねはたえず","きみにひそかに","つたへてしかな"]},{"ban":16,"ku":["人とはぬ","庵の庭には","落葉のみ","つもりゆくかな","静けさのまま"],"yomi":["ひととはぬ","いほのにわには","おちばのみ","つもりゆくかな","しずけさのまま"]}]}
