{"poems":[{"ban":1,"ku":["菜の花の","畑を分けて","ゆく水の","底まで黄なる","春の昼かな"],"yomi":["なのはなの","はたけをわけて","ゆくみづの","そこまできなる","はるのひるかな"]},{"ban":8,"ku":["風わたる","稲穂の波の","寄せてきて","案山子の裾に","砕けては消ゆ"],"yomi":["かぜわたる","いなほのなみの","よせてきて","かかしのすそに","くだけてはきゆ"]},{"ban":11,"ku":["同じ道","帰るばかりの","仲なれど","分かれの辻の","遠くあれかし"],"yomi":["おなじみち","かへるばかりの","なかなれど","わかれのつじの","とほくあれかし"]},{"ban":16,"ku":["朝市の","声に値切られ","笑はれて","蕪ひとつを","余分にもらふ"],"yomi":["あさいちの","こゑにねぎられ","わらはれて","かぶらひとつを","よぶんにもらふ"]}]}
