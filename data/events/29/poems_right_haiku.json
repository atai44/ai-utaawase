{"poems":[{"ban":2,"ku":["春田打つ","牛の歩みの","遅きかな","霞に濡れし","里の朝風"],"yomi":["はるたうつ","うしのあゆみの","おそきかな","かすみにぬれし","さとのあさかぜ"]},{"ban":8,"ku":["黄金なす","稲穂の波に","風渡る","秋の夕べを","雁の鳴くなり"],"yomi":["こがねなす","いなほのなみに","かぜわたる","あきのゆうべを","かりのなくなり"]},{"ban":10,"ku":["橘の","香をとめて来し","人しのぶ","夏の夜の夢","覚めぬ別れを"],"yomi":["たちばなの","かをとめてこし","ひとしのぶ","なつのよのゆめ","さめぬわかれを"]},{"ban":15,"ku":["読みさしの","紙の間に","挟む花","散りにし跡の","夢の続きを"],"yomi":["よみさしの","かみのあいだに","はさむはな","ちりにしあとの","ゆめのつづきを"]}]}
