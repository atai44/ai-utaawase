{"poems":[{"ban":4,"ku":["苔むせる","岩間を漏るる","真清水に","結ぶ手さへも","秋の心地す"],"yomi":["こけむせる","いわまをもるる","ましみずに","むすぶてさえも","あきのここちす"]},{"ban":6,"ku":["漕ぎ出でし","舟も動かぬ","夕凪に","海人の焚く火の","煙ぞ直き"],"yomi":["こぎいでし","ふねもうごかぬ","ゆうなぎに","あまのたくひの","けぶりぞなおき"]},{"ban":10,"ku":["橘の","香を我が袖に","移せども","移らぬ人の","心なりけり"],"yomi":["たちばなの","かをわがそでに","うつせども","うつらぬひとの","こころなりけり"]},{"ban":13,"ku":["写真には","笑みし君のみ","残りけり","撮りし我が手の","震へ知らずて"],"yomi":["しゃしんには","えみしきみのみ","のこりけり","とりしわがての","ふるえしらずて"]}]}
