{"poems":[{"ban":1,"ku":["菜の花の","咲き満つ野辺は","果てもなし","夕日の色に","溶けて霞める"],"yomi":["なのはなの","さきみつのべは","はてもなし","ゆふひのいろに","とけてかすめる"]},{"ban":5,"ku":["むすぶ手に","夏の日影も","砕けけり","道の辺清き","岩井の水に"],"yomi":["むすぶてに","なつのひかげも","くだけけり","みちのべきよき","いはゐのみづに"]},{"ban":12,"ku":["言ひさして","呑みし言葉の","苦さのみ","返らぬ道を","ひとり振り向く"],"yomi":["いひさして","のみしことばの","にがさのみ","かへらぬみちを","ひとりふりむく"]},{"ban":13,"ku":["写し絵の","君は変はらず","笑みながら","色あせゆくは","我が身なりけり"],"yomi":["うつしゑの","きみはかはらず","ゑみながら","いろあせゆくは","わがみなりけり"]}]}
