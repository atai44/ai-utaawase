{"poems":[{"ban":4,"ku":["秋風に","散らぬ紅葉の","錦織り","旅人の足","留めてぞ見る"],"yomi":["あきかぜに","ちらぬもみぢの","にしきおり","たびびとのあし","とどめてぞみる"]},{"ban":7,"ku":["霜夜半","冴えたる空に","鶴の声","遠く響きて","夢もさめぬる"],"yomi":["しもよなか","さえたるそらに","つるのこえ","とおくひびきて","ゆめもさめぬる"]},{"ban":12,"ku":["笛の音に","思ひを載せて","吹く風の","行方も知らぬ","君が心か"],"yomi":["ふえのねに","おもひをのせて","ふくかぜの","ゆくえもしらぬ","きみがこころか"]},{"ban":16,"ku":["暁の","山の端白み","鐘の音の","余韻ぞ残る","谷に響きて"],"yomi":["あかつきの","やまのはしらみ","かねのねの","よいんぞのこる","たににひびきて"]}]}
