{"poems":[{"ban":2,"ku":["夏草の","深野を分くる","旅人の","笠のみ見えて","風わたるなり"],"yomi":["なつくさの","ふかのをわくる","たびびとの","かさのみみえて","かぜわたるなり"]},{"ban":8,"ku":["遠方の","里は時雨れて","夕煙","ひとすぢ白く","立ちぞわづらふ"],"yomi":["をちかたの","さとはしぐれて","ゆふけぶり","ひとすぢしろく","たちぞわづらふ"]},{"ban":9,"ku":["氷りゆく","池の汀を","離れ来て","月の宿りに","鴨ぞ寄り添ふ"],"yomi":["こほりゆく","いけのみぎはを","はなれきて","つきのやどりに","かもぞよりそふ"]},{"ban":13,"ku":["主なき","宿と知りつつ","叩く戸の","音にわが身ぞ","おどろかれぬる"],"yomi":["あるじなき","やどとしりつつ","たたくとの","おとにわがみぞ","おどろかれぬる"]}]}
