{"poems":[{"ban":4,"ku":["立ち帰る","道こそなけれ","紅葉葉の","錦の山に","人を留めて"],"yomi":["たちかへる","みちこそなけれ","もみぢばの","にしきのやまに","ひとをとどめて"]},{"ban":6,"ku":["関守も","留めぬものは","秋風の","袖吹き返す","逢坂の山"],"yomi":["せきもりも","とどめぬものは","あきかぜの","そでふきかへす","あふさかのやま"]},{"ban":9,"ku":["冴えわたる","池の汀の","薄氷","浮き寝の鴨の","夢や閉づらむ"],"yomi":["さえわたる","いけのみぎはの","うすごほり","うきねのかもの","ゆめやとづらむ"]},{"ban":15,"ku":["開き見る","古き地図には","今は無き","川の名ありて","町を流るる"],"yomi":["ひらきみる","ふるきちずには","いまはなき","かはのなありて","まちをながるる"]}]}
