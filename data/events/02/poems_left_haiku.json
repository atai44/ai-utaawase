{"poems":[{"ban":2,"ku":["春来ても","残る寒さに","炭火恋ふ","袖に沁むかぜ","花はまだ見ず"],"yomi":["はるきても","のこるさむさに","すみびこふ","そでにしむかぜ","はなはまだみず"]},{"ban":7,"ku":["枯れ野原","朝霜白く","鶴の声","凍つる風に","旅人ぞ行く"],"yomi":["かれのはら","あさしもしろく","つるのこえ","こおつるかぜに","たびびとぞゆく"]},{"ban":11,"ku":["月影に","君を偲べば","袖濡れて","宵もすがらに","ひとり眺むる"],"yomi":["つきかげに","きみをしのべば","そでぬれて","よいもすがらに","ひとりながむる"]},{"ban":15,"ku":["旅寝して","宿の軒端に","雨の音","夢も結ばず","故郷を恋ふ"],"yomi":["たびねして","やどののきばに","あめのおと","ゆめもむすばず","ふるさとをこふ"]}]}
