{"poems":[{"ban":4,"ku":["宵の間の","庭の葉末に","息つめて","風のおとなひ","待つ夏の夜"],"yomi":["よいのまの","にわのはすえに","いきつめて","かぜのおとなひ","まつなつのよる"]},{"ban":8,"ku":["寝もやらぬ","枕に近く","音立てて","霰こぼるる","冬の夜の床"],"yomi":["ねもやらぬ","まくらにちかく","おとたてて","あられこぼるる","ふゆのよのとこ"]},{"ban":11,"ku":["眺むれば","同じ月かと","思ふ夜の","君も見るらむ","空ぞ恋しき"],"yomi":["ながむれば","おなじつきかと","おもふよの","きみもみるらむ","そらぞこひしき"]},{"ban":13,"ku":["絶え間なく","峰に別るる","白雲の","行方も知らぬ","人をうらみつ"],"yomi":["たえまなく","みねにわかるる","しらくもの","ゆくえもしらぬ","ひとをうらみつ"]}]}
