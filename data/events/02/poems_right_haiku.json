{"poems":[{"ban":2,"ku":["梅が枝に","残る寒さの","春を待つ","蕾はまだか","風ぞ冷たき"],"yomi":["うめがえに","のこるさむさの","はるをまつ","つぼみはまだか","かぜぞつめたき"]},{"ban":5,"ku":["秋風に","揺れて零るる","萩の露","玉と散りつつ","月にきらめく"],"yomi":["あきかぜに","ゆれてこぼるる","はぎのつゆ","たまとちりつつ","つきにきらめく"]},{"ban":10,"ku":["橋姫の","待つ夜の床も","君来ずば","橋の下ゆく","水に問はまし"],"yomi":["はしひめの","まつよのとこも","きみこずば","はしのしたゆく","みずにとはまし"]},{"ban":16,"ku":["窓近く","松吹く風の","音涼し","夢もさめけり","ひとり寝の床"],"yomi":["まどちかく","まつふくかぜの","おとすずし","ゆめもさめけり","ひとりねのとこ"]}]}
