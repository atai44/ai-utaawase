{"poems":[{"ban":1,"ku":["池のへの","岸の若菜を","摘みにけり","雪間の水も","ぬるむ朝かな"],"yomi":["いけのへの","きしのわかなを","つみにけり","ゆきまのみずも","ぬるむあさかな"]},{"ban":6,"ku":["朝顔の","露にひらける","色見れば","秋のあはれも","今ぞ知らるる"],"yomi":["あさがおの","つゆにひらける","いろみれば","あきのあわれも","いまぞしらるる"]},{"ban":10,"ku":["かち人も","絶えて久しき","宇治の橋","渡らぬ中の","恋ぞ苦しき"],"yomi":["かちびとも","たえてひさしき","うじのはし","わたらぬなかの","こいぞくるしき"]},{"ban":13,"ku":["つれなくも","峰にかかれる","浮雲の","晴れぬ思ひを","君や知るらむ"],"yomi":["つれなくも","みねにかかれる","うきぐもの","はれぬおもいを","きみやしるらむ"]}]}
