{"poems":[{"ban":3,"ku":["夏の夜の","月影宿す","山の井の","結ぶ手さへも","秋の心地す"],"yomi":["なつのよの","つきかげやどす","やまのゐの","むすぶてさへも","あきのここちす"]},{"ban":8,"ku":["さ夜ふけて","槙の板屋に","音すなり","夢路もたゆる","霰降る夜は"],"yomi":["さよふけて","まきのいたやに","おとすなり","ゆめぢもたゆる","あられふるよは"]},{"ban":12,"ku":["いかにせむ","言の葉にさへ","出でやらで","心に初むる","色の深さを"],"yomi":["いかにせむ","ことのはにさへ","いでやらで","こころにそむる","いろのふかさを"]},{"ban":16,"ku":["窓近き","松の嵐の","音にこそ","昔の友の","声を聞きけれ"],"yomi":["まどちかき","まつのあらしの","おとにこそ","むかしのともの","こゑをききけれ"]}]}
