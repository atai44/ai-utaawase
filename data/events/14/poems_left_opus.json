{"poems":[
{"ban":3,"ku":["今朝よりは","蝉の羽衣","たちかへて","花の香うすき","袖の涼しさ"],"yomi":["けさよりは","せみのはごろも","たちかへて","はなのかうすき","そでのすずしさ"]},
{"ban":6,"ku":["天の川","更けゆく空を","眺むれば","逢ふ瀬の波に","月ぞかたぶく"],"yomi":["あまのがは","ふけゆくそらを","ながむれば","あふせのなみに","つきぞかたぶく"]},
{"ban":10,"ku":["さ夜更けて","霜置く床に","聞く鐘の","声さへ凍る","山寺の空"],"yomi":["さよふけて","しもおくとこに","きくかねの","こゑさへこほる","やまでらのそら"]},
{"ban":16,"ku":["旅人の","行く手の野辺に","影落ちて","入日に向かふ","道ぞはるけき"],"yomi":["たびびとの","ゆくてののべに","かげおちて","いりひにむかふ","みちぞはるけき"]}
]}
