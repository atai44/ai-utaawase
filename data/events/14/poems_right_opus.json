{"poems":[{"ban":1,"ku":["山里の","軒の玉水","音もせで","霞にこもる","春雨ぞ降る"],"yomi":["やまざとの","のきのたまみず","おともせで","かすみにこもる","はるさめぞふる"]},{"ban":6,"ku":["天の川","待ちし逢ふ瀬の","今宵とて","雲吹きはらふ","秋の初風"],"yomi":["あまのがわ","まちしおうせの","こよいとて","くもふきはらう","あきのはつかぜ"]},{"ban":12,"ku":["袖の上に","置く白露の","消えかへり","人に知られぬ","恋に朽ちなむ"],"yomi":["そでのうえに","おくしらつゆの","きえかえり","ひとにしられぬ","こいにくちなん"]},{"ban":14,"ku":["楫枕","夢路も波に","寄せ返り","都は遠き","浦の舟寝に"],"yomi":["かじまくら","ゆめじもなみに","よせかえり","みやこはとおき","うらのふなねに"]}]}
