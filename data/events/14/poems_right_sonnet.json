{"poems":[{"ban":4,"ku":["夏衣","薄きたもとに","風入れて","昼のまどろみ","覚めやらぬかな"],"yomi":["なつごろも","うすきたもとに","かぜいれて","ひるのまどろみ","さめやらぬかな"]},{"ban":8,"ku":["霜白き","庭火の影に","笛さえて","神の遊びの","夜ぞ更けにける"],"yomi":["しもしろき","にはびのかげに","ふえさえて","かみのあそびの","よぞふけにける"]},{"ban":11,"ku":["暁の","鐘に別れを","急かされて","袖のしづくも","乾かぬものを"],"yomi":["あかつきの","かねにわかれを","せかされて","そでのしづくも","かわかぬものを"]},{"ban":16,"ku":["行き暮るる","野路の果てなき","夕日さす","おのが影踏み","急ぐ旅人"],"yomi":["ゆきくるる","のぢのはてなき","ゆふひさす","おのがかげふみ","いそぐたびびと"]}]}
