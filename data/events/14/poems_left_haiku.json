{"poems":[{"ban":2,"ku":["春雨に","花の梢を","濡らしけり","紅深く","色まさりけり"],"yomi":["はるさめに","はなのこずえを","ぬらしけり","くれないふかく","いろまさりけり"]},{"ban":8,"ku":["冬の夜の","社の庭に","笛の音や","鈴のひびきに","雪ぞ舞ひ落つ"],"yomi":["ふゆのよの","やしろのにわに","ふえのねや","すずのひびきに","ゆきぞまひおつ"]},{"ban":9,"ku":["雪の朝","道踏み分けて","君を訪ふ","囲炉裏に温む","梅の香ぞする"],"yomi":["ゆきのあさ","みちふみわけて","きみをとふ","いろりにぬくむ","うめのかぞする"]},{"ban":14,"ku":["旅寝する","浦の苫屋に","波の音","夜ごと聞こゆる","老いの枕に"],"yomi":["たびねする","うらのとまやに","なみのおと","よごときこゆる","おいのまくらに"]}]}
