{"poems":[{"ban":1,"ku":["入相の","鐘の響きに","散りまがふ","花の下陰","暮れぞしにける"],"yomi":["いりあいの","かねのひびきに","ちりまがう","はなのしたかげ","くれぞしにける"]},{"ban":8,"ku":["霜枯れの","垣根にひとり","咲き匂ふ","山茶花のみぞ","冬を知らざる"],"yomi":["しもがれの","かきねにひとり","さきにおう","さざんかのみぞ","ふゆをしらざる"]},{"ban":9,"ku":["降りすさぶ","時雨の雲の","絶え間より","濡れて出でたる","冬の夜の月"],"yomi":["ふりすさぶ","しぐれのくもの","たえまより","ぬれていでたる","ふゆのよのつき"]},{"ban":15,"ku":["呼ぶ声に","今は応へぬ","たらちねの","面影ばかり","夢に見えつつ"],"yomi":["よぶこえに","いまはこたえぬ","たらちねの","おもかげばかり","ゆめにみえつつ"]}]}
