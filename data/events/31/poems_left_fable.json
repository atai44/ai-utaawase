{"poems":[{"ban":4,"ku":["端居して","足をおろせば","夏の夜の","闇やはらかく","草の匂ひす"],"yomi":["はしゐして","あしをおろせば","なつのよの","やみやはらかく","くさのにほひす"]},{"ban":7,"ku":["稲刈りて","用なき案山子","なほ立てり","借りし帽子を","夕日に染めて"],"yomi":["いねかりて","ようなきかかし","なほたてり","かりしぼうしを","ゆふひにそめて"]},{"ban":12,"ku":["妻を恋ふ","鹿の遠音に","目覚めては","君なき床の","広さを知りぬ"],"yomi":["つまをこふ","しかのとほねに","めざめては","きみなきとこの","ひろさをしりぬ"]},{"ban":16,"ku":["雨上がり","路地の窪みの","水たまり","跨ぐ子どもの","空を踏みゆく"],"yomi":["あめあがり","ろぢのくぼみの","みづたまり","またぐこどもの","そらをふみゆく"]}]}
