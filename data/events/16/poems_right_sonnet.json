{"poems":[
{"ban":1,"ku":["有明の","空に残れる","月影を","霞にこめて","鐘ぞ響ける"],"yomi":["ありあけの","そらにのこれる","つきかげを","かすみにこめて","かねぞひびける"]},
{"ban":6,"ku":["小夜更けて","遠き岡辺の","鹿の音は","近き籬の","声に重なる"],"yomi":["さよふけて","とおきおかべの","しかのねは","ちかきまがきの","こえにかさなる"]},
{"ban":12,"ku":["めくるたび","君が名ばかり","待たれつつ","残る日数の","薄くなりゆく"],"yomi":["めくるたび","きみがなばかり","またれつつ","のこるひかずの","うすくなりゆく"]},
{"ban":16,"ku":["語るべき","昔を知れる","人はみな","先立ちゆきて","君ひとり待つ"],"yomi":["かたるべき","むかしをしれる","ひとはみな","さきだちゆきて","きみひとりまつ"]}
]}
