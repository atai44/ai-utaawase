{"poems":[{"ban":2,"ku":["散りはてし","花の梢に","鶯の","声のみ残る","春の暮かな"],"yomi":["ちりはてし","はなのこずゑに","うぐひすの","こゑのみのこる","はるのくれかな"]},{"ban":5,"ku":["夕風に","池の蓮の","葉をかへし","こぼるる露に","月ぞ宿れる"],"yomi":["ゆふかぜに","いけのはちすの","はをかへし","こぼるるつゆに","つきぞやどれる"]},{"ban":11,"ku":["知らせじと","思ふ涙を","いかにして","枕ばかりは","人に告ぐらむ"],"yomi":["しらせじと","おもふなみだを","いかにして","まくらばかりは","ひとにつぐらむ"]},{"ban":13,"ku":["片糸の","縒りあはぬ身と","知りながら","結ぼほれゆく","恋の乱れよ"],"yomi":["かたいとの","よりあはぬみと","しりながら","むすぼほれゆく","こひのみだれよ"]}]}
