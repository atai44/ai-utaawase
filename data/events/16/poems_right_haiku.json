{"poems":[{"ban":4,"ku":["夕立の","雲間に覗く","月の影","濡れ葉きらめく","涼風ぞ吹く"],"yomi":["ゆうだちの","くもまにのぞく","つきのかげ","ぬればきらめく","すずかぜぞふく"]},{"ban":8,"ku":["松が枝の","白く積もりて","常盤木の","夜半の寒さに","花とぞ見ゆる"],"yomi":["まつがえの","しろくつもりて","ときわぎの","よわのさむさに","はなとぞみゆる"]},{"ban":9,"ku":["夜神楽や","鈴の音響く","篝火の","煙は天に","霜ぞ冴えゆく"],"yomi":["よかぐらや","すずのねひびく","かがりびの","けむりはあめに","しもぞさえゆく"]},{"ban":14,"ku":["山里の","霞に沈む","鐘遠く","春の夕べの","風ぞ吹きゆく"],"yomi":["やまざとの","かすみにしずむ","かねとおく","はるのゆうべの","かぜぞふきゆく"]}]}
