{"poems":[
{"ban":1,"ku":["有明の","月のかげなる","鐘の音に","霞みて春の","夜はあけにけり"],"yomi":["ありあけの","つきのかげなる","かねのねに","かすみてはるの","よはあけにけり"]},
{"ban":5,"ku":["夕風に","池の蓮の","葉を揺らし","露こぼれゆく","音もしづかに"],"yomi":["ゆふかぜに","いけのはちすの","はをゆらし","つゆこぼれゆく","おともしづかに"]},
{"ban":9,"ku":["霜の夜の","庭火のかげに","舞ふ袖の","鈴の音冴えて","明けやらぬかな"],"yomi":["しものよの","にはびのかげに","まふそでの","すずのねさえて","あけやらぬかな"]},
{"ban":15,"ku":["磯枕","夜半の浪音","聞きわびて","夢もむすばぬ","旅の泊りよ"],"yomi":["いそまくら","よはのなみおと","ききわびて","ゆめもむすばぬ","たびのとまりよ"]}
]}
