{"poems":[{"ban":4,"ku":["夕立の","雲間をぬけて","月の影","露ぞこぼるる","庭の萩原"],"yomi":["ゆうだちの","くもまをぬけて","つきのかげ","つゆぞこぼるる","にわのはぎはら"]},{"ban":6,"ku":["山深み","遠くへだたる","鹿の声","近くなりゆく","秋の夕暮"],"yomi":["やまふかみ","とおくへだたる","しかのこえ","ちかくなりゆく","あきのゆうぐれ"]},{"ban":10,"ku":["人づてに","聞くぞかなしき","君が名の","立つ噂こそ","袖ぞぬれぬる"],"yomi":["ひとづてに","きくぞかなしき","きみがなの","たつうわさこそ","そでぞぬれぬる"]},{"ban":13,"ku":["乱れ染む","糸の心も","結ぼほれ","解けぬ思ひを","いかで語らん"],"yomi":["みだれそむ","いとのこころも","むすぼほれ","とけぬおもひを","いかでかたらん"]}]}
