{"poems":[{"ban":1,"ku":["暁を","告げて鶯","春の戸に","薄氷とく","夢もほころぶ"],"yomi":["あかつきを","つげてうぐいす","はるのとに","うすごおりとく","ゆめもほころぶ"]},{"ban":5,"ku":["霧晴れて","露のひかりの","山の端に","紅葉散りしく","月ぞ照らせる"],"yomi":["きりはれて","つゆのひかりの","やまのはに","もみじちりしく","つきぞてらせる"]},{"ban":9,"ku":["雪あかり","窓に障子の","影もなく","灯火消せば","夜ぞ白みぬ"],"yomi":["ゆきあかり","まどにしょうじの","かげもなく","ともしびけせば","よるぞしろみぬ"]},{"ban":14,"ku":["山深み","白糸かくる","滝の音","岩にとどろく","千歳のこだま"],"yomi":["やまふかみ","しらいとかくる","たきのおと","いわにとどろく","ちとせのこだま"]}]}
