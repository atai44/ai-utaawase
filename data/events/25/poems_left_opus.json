{"poems":[{"ban":1,"ku":["有明の","月の名残の","梅が枝に","夢路をいでて","鶯ぞ鳴く"],"yomi":["ありあけの","つきのなごりの","うめがえに","ゆめぢをいでて","うぐひすぞなく"]},{"ban":6,"ku":["入日さす","櫨の梢の","鵙の声","ひとり聞く身に","秋ぞ暮れゆく"],"yomi":["いりひさす","はじのこずゑの","もずのこゑ","ひとりきくみに","あきぞくれゆく"]},{"ban":11,"ku":["忍ぶれど","涙の時雨","ふりそめて","袖のもみぢぞ","色にいでぬる"],"yomi":["しのぶれど","なみだのしぐれ","ふりそめて","そでのもみぢぞ","いろにいでぬる"]},{"ban":13,"ku":["音にのみ","聞きし人ゆゑ","面影も","知らぬ夢路に","迷ひぬるかな"],"yomi":["おとにのみ","ききしひとゆゑ","おもかげも","しらぬゆめぢに","まよひぬるかな"]}]}
