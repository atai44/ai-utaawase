{"poems":[{"ban":4,"ku":["行く水の","音さへ涼し","柏木の","葉守の神の","蔭に休めば"],"yomi":["ゆくみづの","おとさへすずし","かしはぎの","はもりのかみの","かげにやすめば"]},{"ban":7,"ku":["荒れし夜の","名残を問へば","秋の野に","ひとり起き伏す","女郎花かな"],"yomi":["あれしよの","なごりをとへば","あきののに","ひとりおきふす","をみなへしかな"]},{"ban":9,"ku":["逢坂の","関の戸あけて","雲居路へ","引き連れてゆく","望月の駒"],"yomi":["あふさかの","せきのとあけて","くもゐぢへ","ひきつれてゆく","もちづきのこま"]},{"ban":13,"ku":["かき交はす","水茎の跡","薄れゆき","消えぬは袖の","涙なりけり"],"yomi":["かきかはす","みづくきのあと","うすれゆき","きえぬはそでの","なみだなりけり"]}]}
