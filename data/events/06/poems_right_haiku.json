{"poems":[{"ban":2,"ku":["雪の下","梅一枝の","春の香を","ほのかに告げて","咲きいでにけり"],"yomi":["ゆきのした","うめひとえだの","はるのかを","ほのかにつげて","さきいでにけり"]},{"ban":8,"ku":["露置けば","庭の草葉も","秋風に","玉と揺れつつ","夜は更けにけり"],"yomi":["つゆおけば","にわのくさばも","あきかぜに","たまとゆれつつ","よはふけにけり"]},{"ban":9,"ku":["野の末に","嘶く駒を","迎へ来て","秋の霧こそ","立ちこめにけり"],"yomi":["ののすえに","いななくこまを","むかへきて","あきのきりこそ","たちこめにけり"]},{"ban":16,"ku":["夜もすがら","波路をわたる","舟人の","空にほのぼの","明けゆく雲路"],"yomi":["よもすがら","なみじをわたる","ふなびとの","そらにほのぼの","あけゆくくもじ"]}]}
