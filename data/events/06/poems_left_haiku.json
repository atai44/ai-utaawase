{"poems":[{"ban":3,"ku":["帰る雁","霞の奥を","声遠く","仄かに消えぬ","春の空かな"],"yomi":["かえるかり","かすみのおくを","こえとおく","ほのかにきえぬ","はるのそらかな"]},{"ban":6,"ku":["蝉の声","秋を呼ぶごと","鳴き急ぐ","夕べの風に","秋は来にけり"],"yomi":["せみのこえ","あきをよぶごと","なきいそぐ","ゆうべのかぜに","あきはきにけり"]},{"ban":10,"ku":["年の暮","風に散りゆく","残る葉も","雪より先に","冬は深まる"],"yomi":["としのくれ","かぜにちりゆく","のこるはも","ゆきよりさきに","ふゆはふかまる"]},{"ban":16,"ku":["夜は明けて","海路の空に","白む雲","波間に赤く","舟は進みぬ"],"yomi":["よはあけて","かいろのそらに","しろむくも","なみまにあかく","ふねはすすみぬ"]}]}
