{"poems":[{"ban":1,"ku":["野辺の雪","まだらに消ゆる","ひまごとに","春の置きける","若草のいろ"],"yomi":["のべのゆき","まだらにきゆる","ひまごとに","はるのおきける","わかくさのいろ"]},{"ban":8,"ku":["浅茅生の","庭におく露","かぞへつつ","こぼして過ぐる","秋の夕風"],"yomi":["あさぢふの","にはにおくつゆ","かぞへつつ","こぼしてすぐる","あきのゆふかぜ"]},{"ban":12,"ku":["逢坂の","関はゆるせど","人ごころ","越えぬ隔ての","なほ残りけり"],"yomi":["あふさかの","せきはゆるせど","ひとごころ","こえぬへだての","なほのこりけり"]},{"ban":15,"ku":["訪ふ人も","なき山かげの","柴の戸に","夜ごと来て照る","月を友とす"],"yomi":["とふひとも","なきやまかげの","しばのとに","よごときててる","つきをともとす"]}]}
