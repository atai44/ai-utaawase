{
 "poems": [
  {
   "ban": 1,
   "ku": [
    "昨日まで",
    "数へし峰の",
    "一つ松",
    "霞に消えて",
    "春は来にけり"
   ],
   "yomi": [
    "きのふまで",
    "かぞへしみねの",
    "ひとつまつ",
    "かすみにきえて",
    "はるはきにけり"
   ]
  },
  {
   "ban": 5,
   "ku": [
    "流れゆく",
    "水にうつれる",
    "蛍火は",
    "消えずに沈む",
    "星かとぞ見る"
   ],
   "yomi": [
    "ながれゆく",
    "みづにうつれる",
    "ほたるびは",
    "きえずにしづむ",
    "ほしかとぞみる"
   ]
  },
  {
   "ban": 11,
   "ku": [
    "冴ゆる夜の",
    "雲のけしきに",
    "寝もやらで",
    "幾たび戸ぼそ",
    "押しあけつらむ"
   ],
   "yomi": [
    "さゆるよの",
    "くものけしきに",
    "ねもやらで",
    "いくたびとぼそ",
    "おしあけつらむ"
   ]
  },
  {
   "ban": 14,
   "ku": [
    "書き尽くす",
    "言の葉いかに",
    "散りぬらむ",
    "風のたよりも",
    "音せざりけり"
   ],
   "yomi": [
    "かきつくす",
    "ことのはいかに",
    "ちりぬらむ",
    "かぜのたよりも",
    "おとせざりけり"
   ]
  }
 ]
}