    "分かぬまで",
    "霞ぞ深き",
    "春のあけぼの"
   ],
   "yomi": [
    "をちかたの",
    "こずゑはそれと",
    "わかぬまで",
    "かすみぞふかき",
    "はるのあけぼの"
   ]
  },
  {
   "ban": 8,
   "ku": [
    "分けゆけば",
    "袖に露ちる",
    "野辺の道",
    "ふみやすらへば",
    "松虫の声"
   ],
   "yomi": [
    "わけゆけば",
    "そでにつゆちる",
    "のべのみち",
    "ふみやすらへば",
    "まつむしのこゑ"
   ]
  },
  {
   "ban": 12,
   "ku": [
    "人知れぬ",
    "思ひは閨の",
    "ともし火の",
    "消えなで夜半に",
    "ひとりこがるる"
   ],
   "yomi": [
    "ひとしれぬ",
    "おもひはねやの",
    "ともしびの",
    "きえなでよはに",
    "ひとりこがるる"
   ]
  },
  {
   "ban": 16,
   "ku": [
    "今日もまた",
    "暮れぬと告ぐる",
    "入相の",
    "鐘に戸をさす",
    "山の下庵"
   ],
   "yomi": [
    "けふもまた",
    "くれぬとつぐる",
    "いりあひの",
    "かねにとをさす",
    "やまのしたいほ"
   ]
  }
 ]
