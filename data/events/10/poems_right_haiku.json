{"poems":[{"ban":3,"ku":["夕映えの","田面に満ちて","蛙鳴く","声のまにまに","春の宵かな"],"yomi":["ゆうばえの","たおもにみちて","かわずなく","こえのまにまに","はるのよいかな"]},{"ban":5,"ku":["山陰の","鹿のまなこに","火を掲げ","けものも凍る","夏の夜の闇"],"yomi":["やまかげの","しかのまなこに","ひをかかげ","けものもこおる","なつのよのやみ"]},{"ban":10,"ku":["白霰","降りしく野辺に","鷹放つ","羽がひ白く","冬野の狩りや"],"yomi":["しらあられ","ふりしくのべに","たかはなつ","はがいしろく","ふゆののかりや"]},{"ban":16,"ku":["神垣に","御幣はためき","日はのぼる","千代の松風","吹き渡るらし"],"yomi":["かみがきに","ごへいはためき","ひはのぼる","ちよのまつかぜ","ふきわたるらし"]}]}
