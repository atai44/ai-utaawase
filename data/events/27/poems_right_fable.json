{"poems":[{"ban":3,"ku":["清滝の","瀬々の白波","吹き分けて","杉の下道","風ぞ涼しき"],"yomi":["きよたきの","せぜのしらなみ","ふきわけて","すぎのしたみち","かぜぞすずしき"]},{"ban":8,"ku":["誰が訪ふと","咎むる犬の","声遠し","雪に埋るる","里の夜更けに"],"yomi":["たがとうと","とがむるいぬの","こえとおし","ゆきにうもるる","さとのよふけに"]},{"ban":9,"ku":["物言へば","言葉の先に","白く立つ","息も凍れる","霜の朝明け"],"yomi":["ものいえば","ことばのさきに","しろくたつ","いきもこおれる","しものあさあけ"]},{"ban":13,"ku":["頼みこし","夢の通ひ路","踏み分けて","行けども君に","逢はで明けぬる"],"yomi":["たのみこし","ゆめのかよいじ","ふみわけて","ゆけどもきみに","あわであけぬる"]}]}
