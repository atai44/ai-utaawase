{"poems":[{"ban":4,"ku":["入日さす","外山の上に","立ちのぼる","雲の峰さへ","暮れて涼しき"],"yomi":["いりひさす","とやまのうへに","たちのぼる","くものみねさへ","くれてすずしき"]},{"ban":6,"ku":["誰が脱ぎて","かけし袴か","秋の野の","露にほころぶ","花の藤色"],"yomi":["たがぬぎて","かけしはかまか","あきののの","つゆにほころぶ","はなのふぢいろ"]},{"ban":12,"ku":["影をだに","見せぬ人ゆゑ","袖にのみ","宿る月さへ","涙にぞ散る"],"yomi":["かげをだに","みせぬひとゆゑ","そでにのみ","やどるつきさへ","なみだにぞちる"]},{"ban":14,"ku":["呉竹の","世々に重ぬる","節ごとに","君が千歳の","数ぞこもれる"],"yomi":["くれたけの","よよにかさぬる","ふしごとに","きみがちとせの","かずぞこもれる"]}]}
