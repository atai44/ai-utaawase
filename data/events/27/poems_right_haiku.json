{"poems":[{"ban":2,"ku":["夏野原","白百合ひらく","風の朝","露の香を吸う","蝶ひとつ来る"],"yomi":["なつのはら","しろゆりひらく","かぜのあさ","つゆのかをすう","ちょうひとつくる"]},{"ban":5,"ku":["山里の","栗のいが割れ","朝霜に","転がる栗よ","秋の音かな"],"yomi":["やまざとの","くりのいがわれ","あさじもに","ころがるくりよ","あきのおとかな"]},{"ban":11,"ku":["思い出の","文の墨の香","煙とぞ","君が心も","灰になりゆく"],"yomi":["おもいでの","ふみのすみのか","けむりとぞ","きみがこころも","はいになりゆく"]},{"ban":15,"ku":["夕暮れの","約束ばかり","門の鈴","来ぬ人を待つ","月ぞ傾く"],"yomi":["ゆうぐれの","やくそくばかり","かどのすず","こぬひとをまつ","つきぞかたむく"]}]}
