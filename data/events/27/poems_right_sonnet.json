{"poems":[{"ban":1,"ku":["春の野に","妻恋ふ雉","鳴くなへに","霞もゆらぐ","朝の光よ"],"yomi":["はるののに","つまこふきぎす","なくなへに","かすみもゆらぐ","あさのひかりよ"]},{"ban":7,"ku":["降る雪の","音なき夜の","灯に","文ひもとけば","昔の人に"],"yomi":["ふるゆきの","おとなきよるの","ともしびに","ふみひもとけば","むかしのひとに"]},{"ban":10,"ku":["硯水","涙にかへて","書く文の","墨の薄さを","恨みつるかな"],"yomi":["すずりみず","なみだにかへて","かくふみの","すみのうすさを","うらみつるかな"]},{"ban":16,"ku":["破れ目を","白き紙貼る","冬支度","風のすさびも","聞かずなりけり"],"yomi":["やぶれめを","しろきかみはる","ふゆじたく","かぜのすさびも","きかずなりけり"]}]}
