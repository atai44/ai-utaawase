{"poems":[{"ban":3,"ku":["清滝の","岩ほを渡る","風涼し","夏を忘れし","人の袂に"],"yomi":["きよたきの","いはほをわたる","かぜすずし","なつをわすれし","ひとのたもとに"]},{"ban":6,"ku":["藤袴","折りて分けゆく","野の末に","残る香りは","秋の形見ぞ"],"yomi":["ふぢばかま","をりてわけゆく","ののすゑに","のこるかをりは","あきのかたみぞ"]},{"ban":10,"ku":["墨すれば","涙ににじむ","水茎の","跡にもしるき","恋の色かな"],"yomi":["すみすれば","なみだににじむ","みづくきの","あとにもしるき","こひのいろかな"]},{"ban":15,"ku":["友待てど","来ぬ夜は更けて","松風の","音のみそよぐ","宿のさびしさ"],"yomi":["ともまてど","こぬよはふけて","まつかぜの","おとのみそよぐ","やどのさびしさ"]}]}
