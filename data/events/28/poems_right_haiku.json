{"poems":[{"ban":4,"ku":["瓜冷やす","井の底深く","揺らぐ影","雲を映して","一つ冷えたり"],"yomi":["うりひやす","いのそこふかく","ゆらぐかげ","くもをうつして","ひとつひえたり"]},{"ban":7,"ku":["秋風は","簾の外に","揺れて鳴る","竹の葉の音","ささやく夕べ"],"yomi":["あきかぜは","すだれのそとに","ゆれてなる","たけのはのおと","ささやくゆうべ"]},{"ban":12,"ku":["足音を","聞き分けるほど","忍び寄る","かの人の足","胸騒ぐ恋"],"yomi":["あしおとを","ききわけるほど","しのびよる","かのひとのあし","むなさわぐこい"]},{"ban":15,"ku":["捨てかねし","古き住まいの","鍵ひとつ","錆びても重き","持ち歩くかな"],"yomi":["すてかねし","ふるきすまいの","かぎひとつ","さびてもおもき","もちあるくかな"]}]}
