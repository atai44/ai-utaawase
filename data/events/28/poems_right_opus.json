{"poems":[{"ban":2,"ku":["若草の","野辺に乱るる","糸遊の","寄る辺も知らず","春ぞ暮れゆく"],"yomi":["わかくさの","のべにみだるる","いとゆふの","よるべもしらず","はるぞくれゆく"]},{"ban":8,"ku":["霜とけて","縁にまどろむ","老い猫の","背にあたたかき","冬の日の影"],"yomi":["しもとけて","えんにまどろむ","おいねこの","せにあたたかき","ふゆのひのかげ"]},{"ban":9,"ku":["灯火の","影揺れやまぬ","小窓打つ","霰の音に","夜は更けにけり"],"yomi":["ともしびの","かげゆれやまぬ","こまどうつ","あられのおとに","よはふけにけり"]},{"ban":16,"ku":["苔むして","目鼻も定か","ならぬ身に","誰か手向けし","野菊一本"],"yomi":["こけむして","めはなもさだか","ならぬみに","たれかたむけし","のぎくひともと"]}]}
