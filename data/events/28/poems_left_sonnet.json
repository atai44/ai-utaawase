{"poems":[{"ban":4,"ku":["井の底の","水に浮かべし","初瓜の","冷えゆく夕べ","風の涼しさ"],"yomi":["いのそこの","みずにうかべし","はつうりの","ひえゆくゆうべ","かぜのすずしさ"]},{"ban":6,"ku":["梢には","ひとつ残れる","柿の実の","夕日に透けて","鳥を待つらむ"],"yomi":["こずえには","ひとつのこれる","かきのみの","ゆうひにすけて","とりをまつらむ"]},{"ban":9,"ku":["窓打てば","夜半に霰の","音すなり","ひとり寝覚めの","袖の寒けさ"],"yomi":["まどうてば","よわにあられの","おとすなり","ひとりねざめの","そでのさむけさ"]},{"ban":14,"ku":["山里の","水に任せて","回る輪の","米つく音に","日は暮れにけり"],"yomi":["やまざとの","みずにまかせて","まわるわの","こめつくおとに","ひはくれにけり"]}]}
