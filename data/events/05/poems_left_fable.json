{"poems":[{"ban":2,"ku":["花さそふ","風のゆくへは","知らねども","水にまかせて","春ぞ流るる"],"yomi":["はなさそふ","かぜのゆくへは","しらねども","みづにまかせて","はるぞながるる"]},{"ban":5,"ku":["ふるさとは","訪ふ人もなき","夕暮れに","荻の上葉を","風ぞおとなふ"],"yomi":["ふるさとは","とふひともなき","ゆふぐれに","をぎのうはばを","かぜぞおとなふ"]},{"ban":10,"ku":["さざ波の","寄るかと見れば","凍りけり","志賀の浦わに","冴ゆる月影"],"yomi":["さざなみの","よるかとみれば","こほりけり","しがのうらわに","さゆるつきかげ"]},{"ban":16,"ku":["朝霧の","底より鐘は","響ききて","軒端も見えぬ","峰の古寺"],"yomi":["あさぎりの","そこよりかねは","ひびききて","のきばもみえぬ","みねのふるでら"]}]}
