{"poems":[{"ban":4,"ku":["訪ふ人の","跡こそ見えね","山里の","門田の道を","埋む紅葉葉"],"yomi":["とふひとの","あとこそみえね","やまざとの","かどたのみちを","うづむもみぢば"]},{"ban":6,"ku":["立ちとまる","袖も千入に","染まりけり","紅葉の下を","越ゆる山路は"],"yomi":["たちとまる","そでもちしほに","そまりけり","もみぢのしたを","こゆるやまぢは"]},{"ban":9,"ku":["冴えわたる","夜半の板間に","聞こゆなり","氷の下を","行く谷の水"],"yomi":["さえわたる","よはのいたまに","きこゆなり","こほりのしたを","ゆくたにのみづ"]},{"ban":14,"ku":["帰るさの","名残に結ぶ","夢にさへ","又きぬぎぬの","袖ぞ露けき"],"yomi":["かへるさの","なごりにむすぶ","ゆめにさへ","またきぬぎぬの","そでぞつゆけき"]}]}
