{"poems":[{"ban":3,"ku":["夕立の","名残の雫","なほ落ちて","雲のはたてに","月ぞすずしき"],"yomi":["ゆふだちの","なごりのしづく","なほおちて","くものはたてに","つきぞすずしき"]},{"ban":5,"ku":["訪ふ人も","絶えし古里","荻の葉に","昔をかへす","秋風ぞ吹く"],"yomi":["とふひとも","たえしふるさと","をぎのはに","むかしをかへす","あきかぜぞふく"]},{"ban":12,"ku":["恋ひわびて","ながむる空の","村雨は","わが袖よりや","降りはじめけむ"],"yomi":["こひわびて","ながむるそらの","むらさめは","わがそでよりや","ふりはじめけむ"]},{"ban":14,"ku":["きぬぎぬの","名残の床に","まどろめば","夢にも鳥の","音こそつらけれ"],"yomi":["きぬぎぬの","なごりのとこに","まどろめば","ゆめにもとりの","ねこそつらけれ"]}]}
