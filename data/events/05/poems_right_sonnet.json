{"poems":[{"ban":4,"ku":["散りしきる","紅葉の下に","道消えて","踏むも惜しけれ","秋の錦を"],"yomi":["ちりしきる","もみじのしたに","みちきえて","ふむもおしけれ","あきのにしきを"]},{"ban":8,"ku":["降りやまぬ","雪のたえまに","あらはれて","遠き峰々","白くかすめり"],"yomi":["ふりやまぬ","ゆきのたえまに","あらわれて","とおきみねみね","しろくかすめり"]},{"ban":10,"ku":["凍てつく夜","湖面に澄める","月影は","氷にまがふ","光なりけり"],"yomi":["いてつくよ","こめんにすめる","つきかげは","こおりにまがう","ひかりなりけり"]},{"ban":13,"ku":["忘れじと","思ひしほどに","面影の","夢にも深く","立ちまさりけり"],"yomi":["わすれじと","おもいしほどに","おもかげの","ゆめにもふかく","たちまさりけり"]}]}
