{"poems":[{"ban":3,"ku":["人はみな","夏の衣に","かへし日を","ひとり春なる","遅桜かな"],"yomi":["ひとはみな","なつのころもに","かへしひを","ひとりはるなる","おそざくらかな"]},{"ban":6,"ku":["渡る人","絶えて久しき","板橋に","錦を敷きて","秋は暮れけり"],"yomi":["わたるひと","たえてひさしき","いたばしに","にしきをしきて","あきはくれけり"]},{"ban":10,"ku":["来ずとても","よしと言ひてし","夕暮れを","戸ざしもやらず","月ぞ更けゆく"],"yomi":["こずとても","よしといひてし","ゆふぐれを","とざしもやらず","つきぞふけゆく"]},{"ban":16,"ku":["同じ月","見るらむ人の","国遠み","雁の翼に","文ことづてむ"],"yomi":["おなじつき","みるらむひとの","くにとほみ","かりのつばさに","ふみことづてむ"]}]}
