{"poems":[
{"ban":1,"ku":["竹の葉の","そよぐ間ごとに","鳴く鶯","春の光を","こぼしつるかな"],"yomi":["たけのはの","そよぐあひだごとに","なくうぐひす","はるのひかりを","こぼしつるかな"]},
{"ban":5,"ku":["穂波立つ","麦の畑に","風過ぎて","黄金の海を","夏は渡れり"],"yomi":["ほなみたつ","むぎのはたけに","かぜすぎて","こがねのうみを","なつはわたれり"]},
{"ban":12,"ku":["住吉の","浜の貝殻","ひとつだに","あはで過ぎぬる","恋ぞ苦しき"],"yomi":["すみよしの","はまのかひがら","ひとつだに","あはですぎぬる","こひぞくるしき"]},
{"ban":15,"ku":["霧深き","川の渡しの","棹の音に","昔も今も","変らぬ世かな"],"yomi":["きりふかき","かはのわたしの","さをのおとに","むかしもいまも","かはらぬよかな"]}
]}
