{"poems":[{"ban":1,"ku":["竹の葉に","声ひそめたる","鶯の","春を告ぐるか","風のまにまに"],"yomi":["たけのはに","こゑひそめたる","うぐひすの","はるをつぐるか","かぜのまにまに"]},{"ban":7,"ku":["夕暮れの","空より落つる","霙かな","袖に冷たく","消えぬ間もなし"],"yomi":["ゆふぐれの","そらよりおつる","みぞれかな","そでにつめたく","きえぬまもなし"]},{"ban":10,"ku":["言ひ出でぬ","心ひとつに","待つ宵の","月傾きて","袖ぞ濡れゆく"],"yomi":["いひいでぬ","こころひとつに","まつよひの","つきかたぶきて","そでぞぬれゆく"]},{"ban":14,"ku":["神垣の","杉の梢に","風過ぎて","千代の古道","声ぞ澄みゆく"],"yomi":["かみがきの","すぎのこずゑに","かぜすぎて","ちよのふるみち","こゑぞすみゆく"]}]}
