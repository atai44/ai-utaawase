{"poems":[{"ban":4,"ku":["青葉風","木陰に憩ふ","蝉の声","涼しさ深し","夕暮れまでも"],"yomi":["あおばかぜ","こかげにいこふ","せみのこゑ","すずしさふかし","ゆふぐれまでも"]},{"ban":7,"ku":["女郎花","露にぬれつつ","秋の野に","ほのかににほふ","夕日の色よ"],"yomi":["をみなへし","つゆにぬれつつ","あきののに","ほのかににほふ","ゆふひのいろよ"]},{"ban":11,"ku":["花に寄る","蝶のかたちに","我が心","君をぞ恋ふる","舞ひ寄る影よ"],"yomi":["はなによる","てふのかたちに","わがこころ","きみをぞこふる","まひよるかげよ"]},{"ban":15,"ku":["入日影","山路をゆけば","斧の音","谷にこだます","夕鐘の声"],"yomi":["いりひかげ","やまぢをゆけば","をののおと","たににこだます","ゆふがねのこゑ"]}]}
