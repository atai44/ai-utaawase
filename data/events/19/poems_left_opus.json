{"poems":[{"ban":2,"ku":["吹く風も","心のどかに","なりにけり","柳の糸を","ゆるくなびけて"],"yomi":["ふくかぜも","こころのどかに","なりにけり","やなぎのいとを","ゆるくなびけて"]},{"ban":7,"ku":["女郎花","なまめく野辺に","露おきて","誰が袖ふれし","香をや残せる"],"yomi":["をみなへし","なまめくのべに","つゆおきて","たがそでふれし","かをやのこせる"]},{"ban":10,"ku":["汀より","凍りそめたる","池水の","半ばは月の","影ぞさやけき"],"yomi":["みぎはより","こほりそめたる","いけみづの","なかばはつきの","かげぞさやけき"]},{"ban":16,"ku":["人も見ぬ","苔の古道","踏みわけて","昔の旅を","我ぞたどれる"],"yomi":["ひともみぬ","こけのふるみち","ふみわけて","むかしのたびを","われぞたどれる"]}]}
