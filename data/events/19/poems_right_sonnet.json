{"poems":[{"ban":1,"ku":["古里の","垣根の隅の","菫草","摘みし昔を","春ぞ忘れぬ"],"yomi":["ふるさとの","かきねのすみの","すみれぐさ","つみしむかしを","はるぞわすれぬ"]},{"ban":5,"ku":["澄みわたる","秋の夜空に","月冴えて","庭の小萩に","影ぞ宿れる"],"yomi":["すみわたる","あきのよぞらに","つきさえて","にはのこはぎに","かげぞやどれる"]},{"ban":12,"ku":["描きとめし","面影ばかり","向かひゐて","言はぬ契りぞ","恋しかりける"],"yomi":["かきとめし","おもかげばかり","むかひゐて","いはぬちぎりぞ","こひしかりける"]},{"ban":16,"ku":["苔むせる","古き街道","杉並木","行く人まれに","日は傾きぬ"],"yomi":["こけむせる","ふるきかいどう","すぎなみき","ゆくひとまれに","ひはかたぶきぬ"]}]}
