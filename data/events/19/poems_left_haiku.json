{"poems":[{"ban":1,"ku":["故郷の","野辺に咲きけり","春風に","俯く菫","我を見るらむ"],"yomi":["ふるさとの","のべにさきけり","はるかぜに","うつむくすみれ","われをみるらむ"]},{"ban":8,"ku":["冬籠","静かなる窓","雪明り","火桶の香り","文読みふける"],"yomi":["ふゆごもり","しずかなるまど","ゆきあかり","ひおけのかおり","ふみよみふける"]},{"ban":11,"ku":["蝶の羽根","ひらひらと舞ふ","花にこそ","恋ふ心あり","誰に告げまし"],"yomi":["ちょうのはね","ひらひらとまふ","はなにこそ","こふこころあり","たれにつげまし"]},{"ban":14,"ku":["古硯","に残る墨か","いにしへの","人の手の跡","偲ばるるかな"],"yomi":["ふるすずり","にのこるすみか","いにしへの","ひとのてのあと","しのばるるかな"]}]}
