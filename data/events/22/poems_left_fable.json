{"poems":[{"ban":4,"ku":["鳴きよわる","籬の虫の","声の間を","埋めてぞ更くる","有明の月"],"yomi":["なきよわる","まがきのむしの","こゑのまを","うめてぞふくる","ありあけのつき"]},{"ban":8,"ku":["招くべき","人も絶えたる","野の末に","なほ風を待つ","枯尾花かな"],"yomi":["まねくべき","ひともたえたる","ののすゑに","なほかぜをまつ","かれをばなかな"]},{"ban":9,"ku":["葉を落とし","尽くせる梢","あらはにて","入日をしばし","掛けてとどむる"],"yomi":["はをおとし","つくせるこずゑ","あらはにて","いりひをしばし","かけてとどむる"]},{"ban":15,"ku":["峰の寺","入相の鐘の","一声に","谷の底より","暮れのぼりゆく"],"yomi":["みねのてら","いりあひのかねの","ひとこゑに","たにのそこより","くれのぼりゆく"]}]}
