{"poems":[
{"ban":1,"ku":["霞みゆく","沖つ潮路の","夕まぐれ","帆は見えずして","舟歌ぞ寄る"],"yomi":["かすみゆく","おきつしほぢの","ゆふまぐれ","ほはみえずして","ふなうたぞよる"]},
{"ban":8,"ku":["招きしも","誰がためならむ","霜枯れの","尾花が末に","野風のみ吹く"],"yomi":["まねきしも","たがためならむ","しもがれの","をばながすゑに","のかぜのみふく"]},
{"ban":12,"ku":["言の葉に","君が名かけば","漏れぬべし","胸にのみ呼ぶ","夜半の忍び音"],"yomi":["ことのはに","きみがなかけば","もれぬべし","むねにのみよぶ","よはのしのびね"]},
{"ban":13,"ku":["数ふれど","逢ふ夜はなきを","天の川","星はいくたび","契りかはせる"],"yomi":["かぞふれど","あふよはなきを","あまのがは","ほしはいくたび","ちぎりかはせる"]}
]}
