{"poems":[{"ban":4,"ku":["鳴き弱る","籬の虫の","声の間に","夜ごと入りくる","風の音かな"],"yomi":["なきよわる","まがきのむしの","こゑのまに","よごといりくる","かぜのおとかな"]},{"ban":6,"ku":["天の川","渡る舟なき","我が宿の","盥の水に","星を浮かべつ"],"yomi":["あまのがは","わたるふねなき","わがやどの","たらひのみづに","ほしをうかべつ"]},{"ban":11,"ku":["来むといふ","その偽りを","命にて","今日も暮らしつ","明日も頼まむ"],"yomi":["こむといふ","そのいつはりを","いのちにて","けふもくらしつ","あすもたのまむ"]},{"ban":16,"ku":["見も知らぬ","人と並びて","立つ軒の","雫数へて","晴れを惜しみつ"],"yomi":["みもしらぬ","ひととならびて","たつのきの","しづくかぞへて","はれををしみつ"]}]}
