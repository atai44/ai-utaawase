{"poems":[{"ban":2,"ku":["蚊遣火の","煙の末に","見えわかぬ","賤が伏屋の","夕月の影"],"yomi":["かやりびの","けぶりのすゑに","みえわかぬ","しづがふせやの","ゆふづきのかげ"]},{"ban":6,"ku":["天の川","紅葉の橋を","渡す夜は","待つ程よりも","明けやすきかな"],"yomi":["あまのがは","もみぢのはしを","わたすよは","まつほどよりも","あけやすきかな"]},{"ban":10,"ku":["人知れず","涙に朽つる","袖の上に","宿る月さへ","色に出でけり"],"yomi":["ひとしれず","なみだにくつる","そでのうへに","やどるつきさへ","いろにいでけり"]},{"ban":13,"ku":["一夜だに","逢ふ瀬はあるを","彦星に","劣る契りの","身ぞ憂かりける"],"yomi":["ひとよだに","あふせはあるを","ひこぼしに","おとるちぎりの","みぞうかりける"]}]}
