{"poems":[{"ban":1,"ku":["春霞","たなびく海に","帰る帆の","影うすれゆく","浦の夕暮"],"yomi":["はるがすみ","たなびくうみに","かえるほの","かげうすれゆく","うらのゆうぐれ"]},{"ban":5,"ku":["霜おけば","まがきの菊の","色ぞ濃き","秋の光に","映えて匂へり"],"yomi":["しもおけば","まがきのきくの","いろぞこき","あきのひかりに","はえてにほへり"]},{"ban":11,"ku":["偽りと","知りつつ頼む","言の葉に","まどふ我が身の","はかなき恋路"],"yomi":["いつはりと","しりつつたのむ","ことのはに","まどふわがみの","はかなきこひぢ"]},{"ban":14,"ku":["草枕","夢も結ばぬ","暁の","鶏の声聞く","旅の空かな"],"yomi":["くさまくら","ゆめもむすばぬ","あかつきの","とりのこゑきく","たびのそらかな"]}]}
