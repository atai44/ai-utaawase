{"poems":[{"ban":3,"ku":["夕顔の","白きにほひに","日は暮れて","門さしかぬる","賤が伏屋よ"],"yomi":["ゆうがおの","しろきにおいに","ひはくれて","かどさしかぬる","しづがふせやよ"]},{"ban":5,"ku":["籬なる","菊の白露","色添へて","秋の限りを","見する今朝かな"],"yomi":["まがきなる","きくのしらつゆ","いろそへて","あきのかぎりを","みするけさかな"]},{"ban":10,"ku":["忍ぶれど","袖にあまれる","涙こそ","かくれぬ恋の","しるしなりけれ"],"yomi":["しのぶれど","そでにあまれる","なみだこそ","かくれぬこいの","しるしなりけれ"]},{"ban":15,"ku":["入相の","鐘の響きに","山寺の","峰の木の葉も","暮れ渡るなり"],"yomi":["いりあいの","かねのひびきに","やまでらの","みねのこのはも","くれわたるなり"]}]}
