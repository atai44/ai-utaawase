{"poems":[{"ban":1,"ku":["灯を消して","聞けば軒端の","春の雨","土のにほひの","闇にひろがる"],"yomi":["ひをけして","きけばのきばの","はるのあめ","つちのにほひの","やみにひろがる"]},{"ban":7,"ku":["夕霧に","山のかたちの","消えゆけば","鐘の音のみぞ","里に残れる"],"yomi":["ゆふぎりに","やまのかたちの","きえゆけば","かねのねのみぞ","さとにのこれる"]},{"ban":12,"ku":["君が窓","灯ともるを見て","帰る夜の","道はひとりの","影ばかりなり"],"yomi":["きみがまど","ひともるをみて","かへるよの","みちはひとりの","かげばかりなり"]},{"ban":13,"ku":["発車ベル","鳴りやむまでの","指さきを","離せば窓に","君遠ざかる"],"yomi":["はっしゃべる","なりやむまでの","ゆびさきを","はなせばまどに","きみとほざかる"]}]}
