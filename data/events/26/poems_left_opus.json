{"poems":[
{"ban":1,"ku":["春の夜の","闇に濡れゆく","梅が香を","軒の雫の","音にこそ知れ"],"yomi":["はるのよの","やみにぬれゆく","うめがかを","のきのしづくの","おとにこそしれ"]},
{"ban":6,"ku":["山の端を","出でむとすらし","待つ空の","雲の衣も","白みゆくなり"],"yomi":["やまのはを","いでむとすらし","まつそらの","くものころもも","しらみゆくなり"]},
{"ban":11,"ku":["言の葉に","出ださぬ恋の","紅を","問はぬ人にも","袖ぞ見せける"],"yomi":["ことのはに","いださぬこひの","くれなゐを","とはぬひとにも","そでぞみせける"]},
{"ban":16,"ku":["針止めし","時計の中に","亡き父の","発ちにし朝の","時ぞ残れる"],"yomi":["はりとめし","とけいのなかに","なきちちの","たちにしあさの","ときぞのこれる"]}
]}
