{"poems":[
{"ban":3,"ku":["青田風","波立つ見れば","早苗田の","色濃くなりて","夏はなかばに"],"yomi":["あおたかぜ","なみたつみれば","さなえだの","いろこくなりて","なつはなかばに"]},
{"ban":8,"ku":["冬至の日","短き影を","惜しみつつ","ゆず湯に浸る","夜のながきかな"],"yomi":["とうじのひ","みじかきかげを","おしみつつ","ゆずゆにひたる","よのながきかな"]},
{"ban":11,"ku":["忍ぶれど","色に出でぬる","わが恋は","袖の涙の","乾く間もなし"],"yomi":["しのぶれど","いろにいでぬる","わがこいは","そでのなみだの","かわくまもなし"]},
{"ban":15,"ku":["野の寺の","鐘に導き","訪ひくれば","苔の庭にて","僧の掃く音"],"yomi":["ののてらの","かねにみちびき","とひくれば","こけのにわにて","そうのはくおと"]}
]}
