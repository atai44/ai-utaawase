{"poems":[{"ban":4,"ku":["ひぐらしの","声にしづまる","山の端に","残る光を","惜しむ夕暮れ"],"yomi":["ひぐらしの","こえにしづまる","やまのはに","のこるひかりを","おしむゆふぐれ"]},{"ban":8,"ku":["暮れ早き","柚子湯の窓に","湯気立ちて","今日より伸びる","日をぞ数ふる"],"yomi":["くれはやき","ゆずゆのまどに","ゆげたちて","きょうよりのびる","ひをぞかぞふる"]},{"ban":12,"ku":["ともしびの","見ゆる窓辺を","行き過ぎて","声もかけえず","夜半に帰りぬ"],"yomi":["ともしびの","みゆるまどべを","ゆきすぎて","こえもかけえず","よはにかえりぬ"]},{"ban":14,"ku":["ひとけなき","社の庭に","月さえて","鈴の音もなく","更けゆく夜かな"],"yomi":["ひとけなき","やしろのにわに","つきさえて","すずのねもなく","ふけゆくよかな"]}]}
